  .extcam__link:hover {
    text-decoration: none;
  }
  .extcam__link:hover :global(svg) {
    transform: translate(2px, -2px);
  }

  /* ============ 会いに行く（マップ導線バンド） ============ */
  .mapband {
    background: var(--surface-deep);
    border-block: 1px solid var(--line);
  }
  .mapband__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    padding-block: var(--space-6);
    flex-wrap: wrap;
  }
  .mapband__eyebrow {
    margin: 0 0 var(--space-2);
    color: var(--accent-ink);
  }
  .mapband__title {
    margin: 0 0 var(--space-2);
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: clamp(1.2rem, 1rem + 1vw, 1.55rem);
    color: var(--text-1);
  }
  .mapband__note {
    margin: 0;
    max-width: 52ch;
    color: var(--text-2);
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  /* ============ 01 番号付き編集リスト（アーカイブ・ファサード付き） ============ */
  .archive {
    display: flex;
    flex-direction: column;
  }
  .archive__row {
    display: grid;
    grid-template-columns: auto 172px 1fr;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-1);
    border-top: 1px solid var(--line);
  }
  .archive__row:last-child {
    border-bottom: 1px solid var(--line);
  }
  .archive__index {
    font-size: 1.5rem;
    color: var(--accent-ink);
    line-height: 1;
  }
  .archive__facade {
    border-radius: var(--radius-s);
  }
  .archive__body {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .archive__title {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.0625rem;
    color: var(--text-1);
  }
  .archive__src {
    margin: 0;
    color: var(--text-3);
  }
  .archive__note {
    margin: 0;
    color: var(--text-2);
    font-size: 0.875rem;
    line-height: 1.7;
  }
  @media (max-width: 560px) {
    .archive__row {
      grid-template-columns: auto 1fr;
      gap: var(--space-3);
    }
    .archive__facade {
      grid-column: 1 / -1;
    }
  }

  /* ============ 02 横スクロールカード（新着フィード） ============ */
  .feed-scroll {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(240px, 1fr);
    gap: var(--space-4);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: var(--space-3);
    margin-inline: calc(-1 * var(--space-5));
    padding-inline: var(--space-5);
    scrollbar-width: thin;
  }
  .feed-fallback {
    margin: 0;
    color: var(--text-3);
    font-size: 0.9375rem;
  }

  /* ============ 03 温泉ストリップ ============ */
  .onsen {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--space-5);
    padding: var(--space-6) var(--space-7);
    background: var(--surface-soft);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    overflow: hidden;
  }
  .onsen__stats {
    display: flex;
    gap: var(--space-6);
    margin: 0 0 var(--space-4);
  }
  .onsen__stat {
    display: flex;
    align-items: baseline;
    gap: 6px;
  }
  .onsen__stat-num {
    font-size: clamp(1.9rem, 1.5rem + 1.6vw, 2.6rem);
    line-height: 1;
    color: var(--accent-ink);
  }
  .onsen__stat-label {
    color: var(--text-2);
    font-size: 0.875rem;
  }
  .onsen__note {
    margin: 0 0 var(--space-5);
    max-width: 52ch;
    color: var(--text-2);
    font-size: 0.9375rem;
  }
  .onsen__art .steam {
    width: clamp(80px, 10vw, 130px);
  }
  .steam path {
    stroke: var(--line-strong);
    stroke-width: 1.5;
    stroke-linecap: round;
  }
  .steam path:nth-child(1) { opacity: 0.55; }
  .steam path:nth-child(2) { opacity: 0.9; }
  .steam path:nth-child(3) { opacity: 0.7; }
  @media (max-width: 640px) {
    .onsen {
      grid-template-columns: 1fr;
      padding: var(--space-5);
    }
    .onsen__art {
      display: none;
    }
  }

  /* ============ 04 記事カード（2列） ============ */
  .reads {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: var(--space-4);
  }
</style>

