---
/**
 * トップページ = ライブビューア主役（仕様 §4.1 / デザインガイドライン準拠）。
 *
 * 2026-07-10 ユーザー指示「メインは24時間ライブカメラ。国内外すべての公開カメラを集める」を受け、
 * トップ最上部を大型ライブビューア＋カメラ切替リストに再構成した。旧「いま配信中」「いつでも見られる」を統合。
 *
 * 構成:
 *   HERO   ライブビューア    → 大プレイヤー(facade)＋カメラ切替リスト（always常設＋ライブ検知で合流）
 *   —      配信で浮上するカメラ → オフライン時の定期ライブ組を「配信元」一覧で紹介（国内外）
 *   —      世界のカメラ        → 埋め込み不可の外部カメラをリンク枠で紹介
 *   —      会いに行く          → 施設マップ導線バンド
 *   01 ARCHIVE よりぬきアーカイブ → 番号付き編集リスト
 *   02 FEED    新着動画フィード   → 横スクロールカード（RSS由来・クライアント描画）
 *   03 ONSEN   今シーズンの温泉   → 特集ストリップ
 *   04 READS   新着記事          → 編集カード
 *
 * セキュリティ（security.md §3）: live-status.json 由来の外部文字列（動画タイトル・チャンネル名）は
 *   クライアントで textContent / setAttribute のみで挿入する（innerHTML への外部文字列連結を禁止）。
 *   自前HLS（モスクワ・Bella等）は埋め込まずリンク紹介のみ（コードにストリームURLを含めない）。
 */
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
import VideoFacade from '../components/VideoFacade.astro';
import channelsData from '../data/channels.json';
import { classifyOnsen, getOnsenCalStatus, isOnsenSeason } from '../lib/onsen';

const channels = channelsData.channels;
const channelBySlug = Object.fromEntries(channels.map((c) => [c.slug, c]));
const COUNTRY_JA: Record<string, string> = {
  JP: '日本',
  AU: 'オーストラリア',
  LV: 'ラトビア',
  US: 'アメリカ',
  TW: '台湾',
  RU: 'ロシア',
  HU: 'ハンガリー',
  UA: 'ウクライナ',
  PL: 'ポーランド',
  KR: '韓国',
  CN: '中国',
};
const jaCountry = (code: string): string => COUNTRY_JA[code] ?? code;
const thumb = (id: string): string => `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;

// --- ビューアの切替リスト（基礎）= display:always の常設カメラを平坦化 ---
// カピバラ確認不可・停止中は出さない（誠実性優先）。ライブ検知でLIVE合流・ID採用はクライアントで行う。
const viewerCameras = channels
  .filter((c) => c.display === 'always' && c.status === 'active' && c.capybaraContent !== false)
  .flatMap((c) =>
    (c.liveStreams ?? []).map((s) => ({
      channelSlug: c.slug,
      channelName: c.name,
      type: c.type,
      country: c.country,
      seasonalNote: c.seasonalNote ?? '',
      embedChecked: c.embedChecked ?? '',
      videoId: s.videoId,
      label: s.label,
      note: s.note,
    })),
  );
const first = viewerCameras[0];

// --- 配信で浮上する「定期ライブの配信元」（オフライン時に紹介）= capybara確認済みの feed/monitor ---
const scheduledSources = channels
  .filter((c) => c.capybaraContent === true && (c.display === 'feed' || c.display === 'monitor'))
  .map((c) => {
    let label = 'ライブ復活を監視中';
    let variant: 'ok' | 'warn' | 'neutral' = 'neutral';
    if (c.slug === 'capybara-taiwan') {
      label = 'ほぼ毎日ライブ';
      variant = 'ok';
    } else if (c.status === 'paused') {
      label = '復活を監視中';
      variant = 'warn';
    } else if (c.display === 'feed') {
      label = '新着・不定期ライブ';
      variant = 'neutral';
    }
    return { name: c.name, country: c.country, label, variant, note: c.watchNote ?? c.tendency ?? '' };
  });

// --- 埋め込み不可の外部カメラ（リンク紹介枠）= display:link ---
const externalCameras = channels
  .filter((c) => c.display === 'link')
  .map((c) => ({
    name: c.name,
    country: c.country,
    // @ts-ignore linkOnly 拡張フィールド
    linkUrl: c.linkUrl as string,
    // @ts-ignore
    hoursNote: (c.hoursNote as string) ?? '',
    tendency: c.tendency ?? '',
  }));

// 03「よりぬきアーカイブ」= featuredArchives（出典チャンネル名を解決）
const archives = channelsData.featuredArchives.map((a) => ({
  ...a,
  channelName: channelBySlug[a.channelSlug]?.name ?? '',
}));

// クライアント（ビューア合流・新着フィード）に渡すチャンネルメタ
const channelsForClient = Object.fromEntries(
  channels.map((c) => [
    c.slug,
    {
      name: c.name,
      embedOk: c.embedOk,
      capybaraContent: c.capybaraContent !== false,
      facilitySlug: c.facilitySlug ?? null,
      watchNote: c.watchNote ?? '',
      tendency: c.tendency ?? '',
      country: c.country,
      type: c.type,
      embedChecked: c.embedChecked ?? '',
    },
  ]),
);

// --- 施設データ（温泉ストリップ＋マップ導線の件数） ---
const allFacilities = await getCollection('facilities');
const facilityCount = allFacilities.length;
const onsenFacilities = allFacilities.filter((e) => e.data.onsen?.has);
const onsenTotal = onsenFacilities.length;
const onsenPermanent = onsenFacilities.filter((e) => classifyOnsen(e.data.onsen!) === 'permanent').length;
const onsenSeasonal = onsenTotal - onsenPermanent;
const onsenActive = onsenFacilities.filter((e) => {
  const s = getOnsenCalStatus(e.data.onsen!).status;
  return s === 'active' || s === 'soon-end' || s === 'soon-start';
}).length;
const onsenInSeason = isOnsenSeason();
const onsenStripLead =
  onsenInSeason && onsenActive > 0
    ? `全国${onsenActive}園でカピバラ温泉が開催中。開催期間を横断のタイムラインで確認できます。`
    : `いまはオフシーズン。通年で入れる${onsenPermanent}園に加え、冬に向けて全国${onsenSeasonal}園が発表待ちです。`;

// 新着記事（articles コレクションを公開日の新しい順に3件）
const articles = (await getCollection('articles'))
  .filter((p) => import.meta.env.DEV || !p.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3)
  .map((p) => ({
    id: p.id,
    name: p.data.title,
    tag: p.data.tags[0] ?? 'よみもの',
    icon: p.data.icon,
    description: p.data.description,
  }));
---

<BaseLayout description="国内外のカピバラ24時間ライブカメラを1つのビューアでまとめて視聴。会える施設マップ・温泉イベントカレンダーも。今すぐ見たい・会いに行きたいを1か所で。">
  {/* ===== HERO: ライブビューア（シグネチャーモーメント＝映像） ===== */}
  <section class="viewer u-grain">
    <div class="container container--hero">
      <div class="viewer__intro">
        <p class="viewer__eyebrow label">Live Capybara Cameras</p>
        <h1 class="viewer__brand">今日は、カピバラ日和。</h1>
        <p class="viewer__lead">
          国内外の公開カピバラライブカメラを、ここでまとめて。カメラを選ぶと、その場で再生します。
        </p>
      </div>

      <div class="viewer__layout">
        {/* 大プレイヤー（facade・初回クリックまで iframe を作らない） */}
        <div class="viewer__main">
          <div
            class="viewer-stage"
            id="viewer-player"
            role="button"
            tabindex="0"
            data-video-id={first?.videoId}
            aria-label={`選択中のカメラを再生: ${first?.channelName ?? ''}`}
          >
            <img
              class="viewer-stage__img"
              id="viewer-stage-img"
              src={first ? thumb(first.videoId) : ''}
              alt=""
              width="1280"
              height="720"
              decoding="async"
            />
            <span class="viewer-stage__scrim" aria-hidden="true"></span>
            <span class="viewer-stage__play" aria-hidden="true"><Icon name="ph:play-fill" /></span>
          </div>
          <div class="viewer-now">
            <span class="viewer-now__badge" id="viewer-now-badge">
              {first?.type === 'seasonal' ? (
                <span class="badge badge--warn">季節限定</span>
              ) : (
                <span class="badge badge--ok">24時間</span>
              )}
            </span>
            <p class="viewer-now__title" id="viewer-now-title">{first?.channelName}</p>
            <p class="viewer-now__meta label" id="viewer-now-meta">
              {first ? `${jaCountry(first.country)} ・ ${first.label}` : ''}
            </p>
            <p class="viewer-now__note" id="viewer-now-note">{first?.note}</p>
            <p class="viewer-now__foot" id="viewer-now-foot">{first?.seasonalNote}</p>
            <p class="viewer-now__checked" id="viewer-now-checked">
              {first?.embedChecked ? `稼働確認 ${first.embedChecked}` : ''}
            </p>
          </div>
        </div>

        {/* カメラ切替リスト */}
        <div class="viewer__rail">
          <p class="viewer__rail-head label">
            <Icon name="ph:television-simple" aria-hidden="true" />
            カメラを選ぶ
          </p>
          <div class="viewer__list" id="viewer-list">
            {viewerCameras.map((cam, i) => (
              <button
                class="viewer-cam"
                type="button"
                data-video-id={cam.videoId}
                data-channel={cam.channelSlug}
                data-name={cam.channelName}
                data-country={jaCountry(cam.country)}
                data-label={cam.label}
                data-note={cam.note}
                data-type={cam.type}
                data-checked={cam.embedChecked}
                data-seasonal={cam.seasonalNote}
                data-live="false"
                aria-pressed={i === 0 ? 'true' : 'false'}
              >
                <span class="viewer-cam__thumb">
                  <img src={thumb(cam.videoId)} alt="" loading="lazy" decoding="async" width="480" height="360" />
                  <span class="viewer-cam__badge" data-badge>
                    {cam.type === 'seasonal' ? (
                      <span class="badge badge--warn">季節限定</span>
                    ) : (
                      <span class="badge badge--ok">24時間</span>
                    )}
                  </span>
                </span>
                <span class="viewer-cam__body">
                  <span class="viewer-cam__name">{cam.channelName}</span>
                  <span class="viewer-cam__meta label">{jaCountry(cam.country)} ・ {cam.label}</span>
                  <span class="viewer-cam__note">{cam.note}</span>
                </span>
              </button>
            ))}
          </div>
          <p class="viewer__rail-foot">
            登録カメラのライブを30分ごとに自動チェック。配信が始まったカメラは、この一覧に「LIVE」で合流します。
          </p>
        </div>
      </div>
    </div>
    {/* クライアントのビューア合流・新着フィード描画で使うチャンネルメタ */}
    <script type="application/json" id="channels-data" set:html={JSON.stringify(channelsForClient)}></script>
  </section>

  {/* ===== 配信で浮上するカメラ（定期ライブの配信元・オフライン時の紹介） ===== */}
  <Section
    label="On schedule"
    title="配信が始まると浮上するカメラ"
    description="24時間ではない定期ライブ型のカメラ。ライブが始まると、上のビューアに自動でLIVE合流します。国内外の配信元を一覧で紹介します。"
    class="band"
  >
    <ul class="sched" aria-label="定期ライブの配信元">
      {scheduledSources.map((s) => (
        <li class="sched__row">
          <span class:list={['badge', `badge--${s.variant}`, 'sched__badge']}>{s.label}</span>
          <span class="sched__body">
            <span class="sched__name">{s.name}</span>
            <span class="sched__meta label">{jaCountry(s.country)}</span>
            <span class="sched__note">{s.note}</span>
          </span>
        </li>
      ))}
    </ul>
  </Section>

  {/* ===== 世界のカメラ（埋め込み不可＝外部リンク紹介） ===== */}
  <Section
    label="Worldwide"
    title="外部サイトで見る世界のカメラ"
    description="埋め込みが提供されていない、または登録が必要なカメラ。転載はせず、公式サイトへのリンクでご案内します。視聴できる時間帯にご注意ください。"
  >
    <div class="extcam-grid">
      {externalCameras.map((c) => (
        <article class="extcam">
          <div class="extcam__body">
            <p class="extcam__meta label">{jaCountry(c.country)}</p>
            <h3 class="extcam__name">{c.name}</h3>
            <p class="extcam__note">{c.tendency}</p>
            {c.hoursNote && (
              <p class="extcam__hours">
                <Icon name="ph:clock" aria-hidden="true" />
                {c.hoursNote}
              </p>
            )}
          </div>
          <a class="extcam__link" href={c.linkUrl} target="_blank" rel="noopener">
            公式サイトで見る
            <Icon name="ph:arrow-up-right" aria-hidden="true" />
          </a>
        </article>
      ))}
    </div>
  </Section>

  {/* ===== 会いに行く（施設マップ導線バンド） ===== */}
  <section class="mapband">
    <div class="container">
      <div class="mapband__inner">
        <div class="mapband__text">
          <p class="mapband__eyebrow label">Visit</p>
          <p class="mapband__title">画面の中の次は、会いに行く。</p>
          <p class="mapband__note">
            全国{facilityCount}施設のカピバラスポットを地図から。温泉・ふれあい・カフェで絞り込めます。
          </p>
        </div>
        <a class="btn btn--primary" href="/map/">
          <Icon name="ph:map-trifold" aria-hidden="true" />
          施設マップを見る
        </a>
      </div>
    </div>
  </section>

  {/* ===== 01 ARCHIVE よりぬきアーカイブ（番号付き編集リスト） ===== */}
  <Section
    index="01"
    label="Archive"
    title="よりぬきアーカイブ"
    description="露天風呂・池そうじ・おやつタイムなどの名場面を、解説つきで手動キュレーション。"
  >
    <ol class="archive">
      {archives.map((a, i) => (
        <li class="archive__row">
          <span class="num archive__index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <VideoFacade class="archive__facade" videoId={a.videoId} title={a.title} ratio="16 / 10" />
          <div class="archive__body">
            <p class="archive__title">{a.title}</p>
            <p class="archive__src label">{a.channelName}</p>
            <p class="archive__note">{a.note}</p>
          </div>
        </li>
      ))}
    </ol>
  </Section>

  {/* ===== 02 FEED 新着動画フィード（横スクロールカード・RSS由来をクライアント描画） ===== */}
  <Section
    index="02"
    label="Daily feed"
    title="新着カピバラ動画フィード"
    description="登録チャンネルの最新投稿を毎日自動で集めて「今日のカピバラ」に。カードをクリックするとYouTubeで開きます。"
    class="band"
  >
    <div id="feed-root">
      <div class="feed-scroll" id="feed-scroll" role="list" hidden></div>
      <p class="feed-fallback" id="feed-fallback">最新の動画を読み込んでいます…</p>
    </div>
  </Section>

  {/* ===== 03 ONSEN 今シーズンの温泉（特集ストリップ・実データ接続） ===== */}
  <Section index="03" label="Onsen" title="今シーズンの温泉情報" moreHref="/onsen/" moreLabel="カレンダーを見る">
    <div class="onsen">
      <div class="onsen__body">
        <ul class="onsen__stats" aria-label="カピバラ温泉のいまの状況">
          <li class="onsen__stat">
            <span class="num onsen__stat-num" id="onsen-stat-primary">
              {onsenInSeason && onsenActive > 0 ? onsenActive : onsenPermanent}
            </span>
            <span class="onsen__stat-label" id="onsen-stat-primary-label">
              {onsenInSeason && onsenActive > 0 ? '園で開催中' : '園が通年営業'}
            </span>
          </li>
          <li class="onsen__stat">
            <span class="num onsen__stat-num">{onsenSeasonal}</span>
            <span class="onsen__stat-label">園が冬季に開催</span>
          </li>
        </ul>
        <p
          class="onsen__note"
          id="onsen-strip-lead"
          data-active={onsenActive}
          data-permanent={onsenPermanent}
          data-seasonal={onsenSeasonal}
          data-inseason={String(onsenInSeason)}
        >
          {onsenStripLead}
        </p>
        <a class="btn btn--primary" href="/onsen/">
          <Icon name="ph:calendar-dots" aria-hidden="true" />
          温泉ごよみを見る
        </a>
        <script
          type="application/json"
          id="onsen-strip-data"
          set:html={JSON.stringify(
            onsenFacilities.map((e) => ({
              start: e.data.onsen!.start ?? null,
              end: e.data.onsen!.end ?? null,
              s: e.data.onsen!.seasonLabel ?? null,
            })),
          )}
        ></script>
      </div>
      <div class="onsen__art" aria-hidden="true">
        <svg class="steam" viewBox="0 0 140 160" fill="none">
          <path d="M40 155 C26 122 54 112 40 78 C30 54 52 42 40 12" />
          <path d="M72 158 C56 124 86 114 72 74 C60 46 84 34 72 8" />
          <path d="M104 155 C90 122 118 112 104 80 C94 56 116 44 104 16" />
        </svg>
      </div>
    </div>
  </Section>

  {/* ===== 04 READS 新着記事（編集カード・2列） ===== */}
  <Section
    index="04"
    label="Reads"
    title="新着記事"
    description="温泉の時期・ふれあい施設・カピバラの生態など、役立つ記事をお届けします。"
    moreHref="/articles/"
    class="band"
  >
    <div class="reads">
      {articles.map((a) => (
        <Card
          variant="editorial"
          class="reads__card"
          title={a.name}
          icon={a.icon}
          meta={a.tag}
          href={`/articles/${a.id}/`}
        >
          {a.description}
        </Card>
      ))}
    </div>
  </Section>
</BaseLayout>

{/* 温泉ストリップの数字・文言を閲覧日で再集計（開催中件数のズレ対策） */}
<script>
  import { getOnsenCalStatus, isOnsenSeason } from '../lib/onsen';

  const dataEl = document.getElementById('onsen-strip-data');
  if (dataEl?.textContent) {
    try {
      const list = JSON.parse(dataEl.textContent) as { start: string | null; end: string | null; s: string | null }[];
      let active = 0;
      let permanent = 0;
      for (const o of list) {
        const st = getOnsenCalStatus({ start: o.start, end: o.end, seasonLabel: o.s }).status;
        if (st === 'permanent') permanent++;
        if (st === 'active' || st === 'soon-end' || st === 'soon-start') active++;
      }
      const seasonal = list.length - permanent;
      const inSeason = isOnsenSeason();

      const numEl = document.getElementById('onsen-stat-primary');
      const labelEl = document.getElementById('onsen-stat-primary-label');
      const leadEl = document.getElementById('onsen-strip-lead');
      if (inSeason && active > 0) {
        if (numEl) numEl.textContent = String(active);
        if (labelEl) labelEl.textContent = '園で開催中';
        if (leadEl)
          leadEl.textContent = `全国${active}園でカピバラ温泉が開催中。開催期間を横断のタイムラインで確認できます。`;
      } else {
        if (numEl) numEl.textContent = String(permanent);
        if (labelEl) labelEl.textContent = '園が通年営業';
        if (leadEl)
          leadEl.textContent = `いまはオフシーズン。通年で入れる${permanent}園に加え、冬に向けて全国${seasonal}園が発表待ちです。`;
      }
    } catch {
      /* 解析失敗時はビルド時の表示をそのまま使う */
    }
  }
</script>

{/* ライブ状態JSONを取得して ①ライブビューアへの合流 ②新着フィード をクライアント描画する。
    セキュリティ: 外部由来文字列は textContent / setAttribute / dataset のみで挿入（innerHTML連結禁止）。 */}
<script>
  import { LIVE_STATUS_URL, LIVE_STATUS_FALLBACK_URL } from '../config';

  type ChannelMeta = {
    name: string;
    embedOk: boolean | null;
    capybaraContent: boolean;
    facilitySlug: string | null;
    watchNote: string;
    tendency: string;
    country: string;
    type: string;
    embedChecked: string;
  };
  type LiveItem = { channelSlug: string | null; videoId: string; title: string; startedAt?: string | null };
  type UpItem = { channelSlug: string | null; videoId: string; title: string; scheduledAt?: string | null };
  type FeedItem = {
    channelSlug: string;
    channelName: string;
    facilitySlug: string | null;
    videoId: string;
    title: string;
    published: string;
  };
  type Status = { updatedAt: string; degraded: boolean; live: LiveItem[]; upcoming: UpItem[]; latestVideos: FeedItem[] };

  const channelsEl = document.getElementById('channels-data');
  const channels: Record<string, ChannelMeta> = channelsEl?.textContent ? JSON.parse(channelsEl.textContent) : {};

  const COUNTRY_JA: Record<string, string> = {
    JP: '日本', AU: 'オーストラリア', LV: 'ラトビア', US: 'アメリカ', TW: '台湾',
    RU: 'ロシア', HU: 'ハンガリー', UA: 'ウクライナ', PL: 'ポーランド', KR: '韓国', CN: '中国',
  };
  const jaCountry = (code: string): string => COUNTRY_JA[code] ?? code ?? '';
  const thumb = (id: string): string => `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;

  // ---------- ビューア ----------
  const stage = document.getElementById('viewer-player');
  const stageImg = document.getElementById('viewer-stage-img') as HTMLImageElement | null;
  const list = document.getElementById('viewer-list');
  const nowBadge = document.getElementById('viewer-now-badge');
  const nowTitle = document.getElementById('viewer-now-title');
  const nowMeta = document.getElementById('viewer-now-meta');
  const nowNote = document.getElementById('viewer-now-note');
  const nowFoot = document.getElementById('viewer-now-foot');
  const nowChecked = document.getElementById('viewer-now-checked');

  let userInteracted = false;

  type BadgeState = 'live' | 'upcoming' | 'idle';
  function makeBadge(state: BadgeState, type: string): HTMLElement {
    const s = document.createElement('span');
    if (state === 'live') {
      s.className = 'live-badge';
      const dot = document.createElement('span');
      dot.className = 'live-badge__dot';
      s.appendChild(dot);
      s.appendChild(document.createTextNode('LIVE'));
    } else if (state === 'upcoming') {
      s.className = 'badge badge--neutral';
      s.textContent = 'まもなく配信';
    } else if (type === 'seasonal') {
      s.className = 'badge badge--warn';
      s.textContent = '季節限定';
    } else {
      s.className = 'badge badge--ok';
      s.textContent = type === '24h' ? '24時間' : 'ライブ';
    }
    return s;
  }

  function setNowPlaying(card: HTMLElement): void {
    const d = card.dataset;
    if (nowBadge) nowBadge.replaceChildren(makeBadge(d.live === 'true' ? 'live' : 'idle', d.type ?? ''));
    if (nowTitle) nowTitle.textContent = d.name ?? '';
    if (nowMeta) nowMeta.textContent = `${d.country ?? ''} ・ ${d.label ?? ''}`;
    if (nowNote) nowNote.textContent = d.note ?? '';
    if (nowFoot) nowFoot.textContent = d.seasonal ?? '';
    if (nowChecked) nowChecked.textContent = d.checked ? `稼働確認 ${d.checked}` : '';
  }

  function selectCard(card: HTMLElement): void {
    if (!list) return;
    for (const b of Array.from(list.querySelectorAll('.viewer-cam'))) b.setAttribute('aria-pressed', 'false');
    card.setAttribute('aria-pressed', 'true');
    if (stage) stage.setAttribute('data-video-id', card.dataset.videoId ?? '');
    if (stageImg && card.dataset.videoId) stageImg.src = thumb(card.dataset.videoId);
    setNowPlaying(card);
  }

  function playCurrent(): void {
    if (!stage) return;
    const id = stage.getAttribute('data-video-id');
    if (!id) return;
    const iframe = document.createElement('iframe');
    iframe.className = 'viewer-stage__iframe';
    // ユーザー操作起点のため autoplay を許可。自動再生ポリシーに合わせ mute=1。
    iframe.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(id)}?autoplay=1&mute=1&rel=0`;
    iframe.title = (nowTitle?.textContent || 'カピバラライブ') as string;
    iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
    iframe.setAttribute('allowfullscreen', '');
    iframe.setAttribute('frameborder', '0');
    stage.replaceChildren(iframe);
    stage.removeAttribute('role');
    stage.removeAttribute('tabindex');
  }

  if (stage) {
    stage.addEventListener('click', () => {
      userInteracted = true;
      playCurrent();
    });
    stage.addEventListener('keydown', (ev) => {
      if (ev.key !== 'Enter' && ev.key !== ' ') return;
      ev.preventDefault();
      userInteracted = true;
      playCurrent();
    });
  }
  if (list) {
    list.addEventListener('click', (ev) => {
      const target = ev.target as Element | null;
      const card = target?.closest?.('.viewer-cam') as HTMLElement | null;
      if (!card || !list.contains(card)) return;
      userInteracted = true;
      selectCard(card);
      playCurrent();
    });
  }

  type DynOpts = {
    videoId: string;
    channelSlug: string;
    name: string;
    countryJa: string;
    label: string;
    note: string;
    type: string;
    checked: string;
    state: BadgeState;
  };
  function buildCamCard(o: DynOpts): HTMLButtonElement {
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'viewer-cam';
    btn.setAttribute('aria-pressed', 'false');
    // dataset 経由（=setAttribute相当）で外部文字列を安全に格納
    btn.dataset.videoId = o.videoId;
    btn.dataset.channel = o.channelSlug;
    btn.dataset.name = o.name;
    btn.dataset.country = o.countryJa;
    btn.dataset.label = o.label;
    btn.dataset.note = o.note;
    btn.dataset.type = o.type;
    btn.dataset.checked = o.checked;
    btn.dataset.seasonal = '';
    btn.dataset.live = o.state === 'live' ? 'true' : 'false';

    const thumbSpan = document.createElement('span');
    thumbSpan.className = 'viewer-cam__thumb';
    const img = document.createElement('img');
    img.src = thumb(o.videoId);
    img.alt = '';
    img.loading = 'lazy';
    img.decoding = 'async';
    img.width = 480;
    img.height = 360;
    const badgeWrap = document.createElement('span');
    badgeWrap.className = 'viewer-cam__badge';
    badgeWrap.setAttribute('data-badge', '');
    badgeWrap.appendChild(makeBadge(o.state, o.type));
    thumbSpan.append(img, badgeWrap);

    const body = document.createElement('span');
    body.className = 'viewer-cam__body';
    const nm = document.createElement('span');
    nm.className = 'viewer-cam__name';
    nm.textContent = o.name;
    const meta = document.createElement('span');
    meta.className = 'viewer-cam__meta label';
    meta.textContent = `${o.countryJa} ・ ${o.label}`;
    const note = document.createElement('span');
    note.className = 'viewer-cam__note';
    note.textContent = o.note;
    body.append(nm, meta, note);

    btn.append(thumbSpan, body);
    return btn;
  }

  function markCardLive(card: HTMLElement): void {
    card.dataset.live = 'true';
    const bw = card.querySelector('[data-badge]');
    if (bw) bw.replaceChildren(makeBadge('live', card.dataset.type ?? ''));
  }
  function adoptCard(card: HTMLElement, newId: string): void {
    card.dataset.videoId = newId;
    const img = card.querySelector('img');
    if (img) (img as HTMLImageElement).src = thumb(newId);
  }

  function reconcileViewer(status: Status | null): void {
    if (!status || !list) return;
    const baseCards = Array.from(list.querySelectorAll('.viewer-cam')) as HTMLElement[];
    // カピバラが映る＆埋め込み可のライブだけ対象（capybaraContent:false は合流させない＝誠実性）
    const liveItems = (status.live ?? []).filter((x) => {
      const ch = x.channelSlug ? channels[x.channelSlug] : undefined;
      return ch && ch.capybaraContent && ch.embedOk !== false;
    });
    const liveIds = new Set(liveItems.map((x) => x.videoId));
    const consumed = new Set<string>();

    // 1) 既存カードの動画IDがそのままライブ → LIVE 昇格
    for (const card of baseCards) {
      const vid = card.dataset.videoId ?? '';
      if (liveIds.has(vid)) {
        markCardLive(card);
        consumed.add(vid);
      }
    }
    // 2) ID再起動組（Roger Williams等）: 未ライブの常設カードに同一チャンネルの新IDを採用
    for (const card of baseCards) {
      if (card.dataset.live === 'true') continue;
      const slug = card.dataset.channel ?? '';
      const cand = liveItems.find((x) => x.channelSlug === slug && !consumed.has(x.videoId));
      if (cand) {
        adoptCard(card, cand.videoId);
        markCardLive(card);
        consumed.add(cand.videoId);
      }
    }
    // 3) 常設外の動的ライブ（Taronga・台湾・国内イベント型など）を合流。国内(JP)は最上位。
    const baseIds = new Set(baseCards.map((c) => c.dataset.videoId ?? ''));
    const dynamics = liveItems.filter((x) => !consumed.has(x.videoId) && !baseIds.has(x.videoId));
    const jp: LiveItem[] = [];
    const other: LiveItem[] = [];
    for (const x of dynamics) {
      const ch = x.channelSlug ? channels[x.channelSlug] : undefined;
      (ch && ch.country === 'JP' ? jp : other).push(x);
    }
    const makeDyn = (x: LiveItem, state: BadgeState): HTMLButtonElement => {
      const ch = (x.channelSlug ? channels[x.channelSlug] : undefined) ?? ({} as ChannelMeta);
      return buildCamCard({
        videoId: x.videoId,
        channelSlug: x.channelSlug ?? '',
        name: ch.name ?? '配信チャンネル',
        countryJa: jaCountry(ch.country ?? ''),
        label: state === 'upcoming' ? 'まもなく配信' : 'ライブ配信',
        note: ch.tendency || ch.watchNote || 'カピバラのライブ配信です。',
        type: ch.type ?? 'event',
        checked: ch.embedChecked ?? '',
        state,
      });
    };
    // 国内ライブは先頭へ（表示順を保つため逆順に prepend）
    for (const x of jp.slice().reverse()) list.insertBefore(makeDyn(x, 'live'), list.firstChild);
    // 海外の動的ライブは末尾へ
    for (const x of other) list.appendChild(makeDyn(x, 'live'));

    // upcoming（配信予定）を「まもなく配信」で末尾に
    const upItems = (status.upcoming ?? []).filter((x) => {
      const ch = x.channelSlug ? channels[x.channelSlug] : undefined;
      return ch && ch.capybaraContent && ch.embedOk !== false;
    });
    for (const x of upItems) {
      if (baseIds.has(x.videoId) || liveIds.has(x.videoId)) continue;
      list.appendChild(makeDyn(x, 'upcoming'));
    }

    // 4) 初期選択: ライブ中の常設(always/24h)カメラの先頭（未操作時のみ）。国内イベントは最上位に出すが主役の初期選択にはしない。
    if (!userInteracted) {
      const firstLiveBase = baseCards.find((c) => c.dataset.live === 'true');
      const target = firstLiveBase ?? (list.querySelector('.viewer-cam') as HTMLElement | null);
      if (target) selectCard(target);
    }
  }

  // ---------- 新着フィード（横スクロール・クリックでYouTube） ----------
  function buildFeedCard(item: FeedItem): HTMLAnchorElement {
    const ch = channels[item.channelSlug];
    const name = item.channelName || ch?.name || '';
    const note = ch?.watchNote || 'カピバラの新着動画です。';
    const date = item.published
      ? new Date(item.published).toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' })
      : '';
    const a = document.createElement('a');
    a.className = 'feed-card';
    a.href = `https://www.youtube.com/watch?v=${encodeURIComponent(item.videoId)}`;
    a.target = '_blank';
    a.rel = 'noopener';
    a.setAttribute('role', 'listitem');

    const media = document.createElement('span');
    media.className = 'feed-card__media';
    const img = document.createElement('img');
    img.className = 'feed-card__img';
    img.src = thumb(item.videoId);
    img.alt = '';
    img.loading = 'lazy';
    img.decoding = 'async';
    media.appendChild(img);

    const body = document.createElement('span');
    body.className = 'feed-card__body';
    const meta = document.createElement('span');
    meta.className = 'feed-card__meta label';
    meta.textContent = date ? `${name} ・ ${date}` : name;
    const title = document.createElement('span');
    title.className = 'feed-card__title';
    title.textContent = item.title;
    const noteEl = document.createElement('span');
    noteEl.className = 'feed-card__note';
    noteEl.textContent = note;
    body.append(meta, title, noteEl);

    a.append(media, body);
    return a;
  }

  function renderFeed(status: Status | null): void {
    const scroll = document.getElementById('feed-scroll');
    const fallback = document.getElementById('feed-fallback');
    if (!scroll || !fallback) return;
    const items = (status?.latestVideos ?? []).slice(0, 16);
    if (items.length === 0) {
      fallback.textContent = '新着動画を読み込めませんでした。時間をおいて再度お試しください。';
      return;
    }
    scroll.replaceChildren(...items.map(buildFeedCard));
    scroll.hidden = false;
    fallback.hidden = true;
  }

  async function loadStatus(): Promise<Status | null> {
    const bust = `?t=${Date.now()}`;
    const remoteConfigured = !LIVE_STATUS_URL.includes('OWNER/');
    const urls =
      import.meta.env.DEV || !remoteConfigured
        ? [LIVE_STATUS_FALLBACK_URL + bust]
        : [LIVE_STATUS_URL + bust, LIVE_STATUS_FALLBACK_URL + bust];
    for (const u of urls) {
      try {
        const res = await fetch(u, { cache: 'no-store' });
        if (res.ok) return (await res.json()) as Status;
      } catch {
        /* 次のURLへ */
      }
    }
    return null;
  }

  loadStatus().then((status) => {
    reconcileViewer(status);
    renderFeed(status);
  });
</script>

