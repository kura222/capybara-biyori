---
/**
 * トップページ = ライブ・映像ハブ（仕様 §4.1 / デザインガイドライン準拠）。
 * P0.5 では 6 セクションを、レイアウトのリズムを変えながら実データ前提の器として実装する:
 *   01 LIVE     いま配信中          → 空状態（マスコット＋理由＋導線）
 *   02 ALWAYS   いつでも見られる      → 特集（大1枚＋小リスト）
 *   03 ARCHIVE  よりぬきアーカイブ    → 番号付き編集リスト
 *   04 FEED     新着動画フィード      → 横スクロールカード
 *   05 ONSEN    今シーズンの温泉      → 特集ストリップ
 *   06 READS    新着記事            → 編集カード（2列）
 * データ接続（ライブ検知・RSS・温泉期間）は P1 以降。
 */
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
import Mascot from '../components/Mascot.astro';
import VideoCard from '../components/VideoCard.astro';
import VideoFacade from '../components/VideoFacade.astro';
import channelsData from '../data/channels.json';
import { classifyOnsen, getOnsenCalStatus, isOnsenSeason } from '../lib/onsen';

// --- 配信チャンネル（channels.json）から各セクションの実データを組み立てる ---
const channels = channelsData.channels;
const channelBySlug = Object.fromEntries(channels.map((c) => [c.slug, c]));
const COUNTRY_JA: Record<string, string> = { JP: '日本', AU: 'オーストラリア', LV: 'ラトビア' };

// 02「いつでも見られるカピバラ」= display:always（24h/seasonal）の常設カメラを平坦化。
// カピバラ確認不可（capybaraContent:false）や停止中は出さない（誠実性優先）。
const alwaysStreams = channels
  .filter((c) => c.display === 'always' && c.status === 'active' && c.capybaraContent !== false)
  .flatMap((c) =>
    (c.liveStreams ?? []).map((s) => ({
      channelSlug: c.slug,
      channelName: c.name,
      type: c.type,
      country: c.country,
      seasonalNote: c.seasonalNote ?? null,
      videoId: s.videoId,
      label: s.label,
      note: s.note,
    })),
  );

// 03「よりぬきアーカイブ」= featuredArchives（出典チャンネル名を解決）
const archives = channelsData.featuredArchives.map((a) => ({
  ...a,
  channelName: channelBySlug[a.channelSlug]?.name ?? '',
}));

// クライアント（LIVE/新着フィードの動的描画）に渡すチャンネルメタ（必要フィールドのみ）
const channelsForClient = Object.fromEntries(
  channels.map((c) => [
    c.slug,
    {
      name: c.name,
      embedOk: c.embedOk,
      capybaraContent: c.capybaraContent !== false,
      facilitySlug: c.facilitySlug ?? null,
      watchNote: c.watchNote ?? '',
      tendency: c.tendency ?? '',
      country: c.country,
    },
  ]),
);

// --- 温泉ストリップ用の実データ集計（/onsen/ と同じ判定を共用） ---
const onsenFacilities = (await getCollection('facilities')).filter((e) => e.data.onsen?.has);
const onsenTotal = onsenFacilities.length;
const onsenPermanent = onsenFacilities.filter((e) => classifyOnsen(e.data.onsen!) === 'permanent').length;
const onsenSeasonal = onsenTotal - onsenPermanent;
const onsenActive = onsenFacilities.filter((e) => {
  const s = getOnsenCalStatus(e.data.onsen!).status;
  return s === 'active' || s === 'soon-end' || s === 'soon-start';
}).length;
const onsenInSeason = isOnsenSeason();
// シーズン中で開催中があれば開催件数を、オフシーズンは常設＋発表待ち見込みを主役に
const onsenStripLead =
  onsenInSeason && onsenActive > 0
    ? `全国${onsenActive}園でカピバラ温泉が開催中。開催期間を横断のタイムラインで確認できます。`
    : `いまはオフシーズン。通年で入れる${onsenPermanent}園に加え、冬に向けて全国${onsenSeasonal}園が発表待ちです。`;

const articles = [
  { name: 'カピバラ温泉はいつからいつまで？全国まとめ', tag: '温泉', icon: 'ph:drop' },
  { name: '関東でカピバラとふれあえる施設まとめ', tag: 'おでかけ', icon: 'ph:map-pin' },
  { name: 'カピバラってどんな動物？生態Q&A', tag: '生態', icon: 'ph:paw-print' },
];
---

<BaseLayout description="カピバラのライブ配信・全国の会える施設マップ・温泉イベントカレンダーをまとめたポータルサイト。今すぐ見たい・会いに行きたいを1か所で。">
  {/* ===== ヒーロー（タイポ型シグネチャー） ===== */}
  <section class="hero u-grain">
    <div class="container container--hero hero__inner">
      <div class="hero__content">
        <p class="hero__eyebrow label">Live &middot; Map &middot; Onsen</p>
        <h1 class="hero__title">今日は、<br />カピバラ日和。</h1>
        <p class="hero__lead">
          全国のカピバラのライブ配信、会える施設マップ、温泉イベントカレンダー。
          「今すぐ見たい」も「会いに行きたい」も、ここから。
        </p>
        <div class="hero__actions">
          <a class="btn btn--primary" href="/map/">
            <Icon name="ph:map-trifold" aria-hidden="true" />
            施設マップを見る
          </a>
          <a class="hero__link" href="/onsen/">
            温泉ごよみを見る
            <Icon name="ph:arrow-right" aria-hidden="true" />
          </a>
        </div>
      </div>

      <div class="hero__art" aria-hidden="true">
        <span class="hero__vlabel label">Capybara Biyori</span>
        <svg class="steam steam--hero" viewBox="0 0 140 200" fill="none">
          <path d="M40 195 C26 158 54 146 40 108 C30 78 52 62 40 26" />
          <path d="M72 200 C56 160 86 148 72 104 C60 70 84 54 72 14" />
          <path d="M104 195 C90 158 118 146 104 110 C94 80 116 64 104 30" />
        </svg>
      </div>
    </div>
  </section>

  {/* ===== 01 LIVE いま配信中（配信検知時のみ出現・空状態フォールバック） ===== */}
  <Section index="01" label="Live" title="いま配信中のカピバラ" space="l">
    {/* live-status.json を fetch し、live[] があればクライアントで LIVE カードを差し込む。
        fetch失敗・0件時は空状態のまま（静的部分だけで完全動作＝既存挙動を壊さない）。 */}
    <div id="live-root" data-state="empty">
      <div class="live-grid" id="live-grid" hidden></div>
      <div class="live-empty" id="live-empty">
        <Mascot size={78} steam={false} class="live-empty__mascot" />
        <div class="live-empty__body">
          <p class="live-empty__title">いまは配信中のカピバラはいません</p>
          <p class="live-empty__note">
            登録チャンネルのライブを30分ごとに自動チェックしています。
            配信が始まると、この場所に「LIVE」カードが並びます。
          </p>
          <a class="live-empty__link" href="#always-on">
            いつでも見られるカピバラを見る
            <Icon name="ph:arrow-right" aria-hidden="true" />
          </a>
        </div>
      </div>
    </div>
    {/* クライアントの LIVE / 新着フィード描画で使うチャンネルメタ */}
    <script type="application/json" id="channels-data" set:html={JSON.stringify(channelsForClient)}></script>
  </Section>

  {/* ===== 02 ALWAYS いつでも見られる（24h/seasonal の常設カメラ・実データ） ===== */}
  <Section
    id="always-on"
    index="02"
    label="Always on"
    title="いつでも見られるカピバラ"
    description="海外の24時間ライブカメラ。サムネイルをクリックすると、その場で再生します。"
    class="band"
  >
    <div class="always-grid">
      {alwaysStreams.map((s) => (
        <VideoCard
          videoId={s.videoId}
          title={s.channelName}
          meta={`${COUNTRY_JA[s.country] ?? s.country} ・ ${s.label}`}
          note={s.note}
          footnote={s.seasonalNote ?? undefined}
          badgeText={s.type === 'seasonal' ? '季節限定' : '24時間'}
          badgeVariant={s.type === 'seasonal' ? 'warn' : 'ok'}
        />
      ))}
    </div>
  </Section>

  {/* ===== 03 ARCHIVE よりぬきアーカイブ（番号付き編集リスト） ===== */}
  <Section
    index="03"
    label="Archive"
    title="よりぬきアーカイブ"
    description="露天風呂・池そうじ・おやつタイムなどの名場面を、解説つきで手動キュレーション。"
  >
    <ol class="archive">
      {archives.map((a, i) => (
        <li class="archive__row">
          <span class="num archive__index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <VideoFacade class="archive__facade" videoId={a.videoId} title={a.title} ratio="16 / 10" />
          <div class="archive__body">
            <p class="archive__title">{a.title}</p>
            <p class="archive__src label">{a.channelName}</p>
            <p class="archive__note">{a.note}</p>
          </div>
        </li>
      ))}
    </ol>
  </Section>

  {/* ===== 04 FEED 新着動画フィード（横スクロールカード・RSS由来をクライアント描画） ===== */}
  <Section
    index="04"
    label="Daily feed"
    title="新着カピバラ動画フィード"
    description="登録チャンネルの最新投稿を毎日自動で集めて「今日のカピバラ」に。カードをクリックするとYouTubeで開きます。"
    class="band"
  >
    <div id="feed-root">
      <div class="feed-scroll" id="feed-scroll" role="list" hidden></div>
      <p class="feed-fallback" id="feed-fallback">最新の動画を読み込んでいます…</p>
    </div>
  </Section>

  {/* ===== 05 ONSEN 今シーズンの温泉（特集ストリップ・実データ接続） ===== */}
  <Section index="05" label="Onsen" title="今シーズンの温泉情報" moreHref="/onsen/" moreLabel="カレンダーを見る">
    <div class="onsen">
      <div class="onsen__body">
        <ul class="onsen__stats" aria-label="カピバラ温泉のいまの状況">
          <li class="onsen__stat">
            <span class="num onsen__stat-num" id="onsen-stat-primary">
              {onsenInSeason && onsenActive > 0 ? onsenActive : onsenPermanent}
            </span>
            <span class="onsen__stat-label" id="onsen-stat-primary-label">
              {onsenInSeason && onsenActive > 0 ? '園で開催中' : '園が通年営業'}
            </span>
          </li>
          <li class="onsen__stat">
            <span class="num onsen__stat-num">{onsenSeasonal}</span>
            <span class="onsen__stat-label">園が冬季に開催</span>
          </li>
        </ul>
        <p
          class="onsen__note"
          id="onsen-strip-lead"
          data-active={onsenActive}
          data-permanent={onsenPermanent}
          data-seasonal={onsenSeasonal}
          data-inseason={String(onsenInSeason)}
        >
          {onsenStripLead}
        </p>
        <a class="btn btn--primary" href="/onsen/">
          <Icon name="ph:calendar-dots" aria-hidden="true" />
          温泉ごよみを見る
        </a>
        {/* 閲覧日でのストリップ再集計用データ（開催中件数はビルド日と閲覧日でズレるため） */}
        <script
          type="application/json"
          id="onsen-strip-data"
          set:html={JSON.stringify(
            onsenFacilities.map((e) => ({
              start: e.data.onsen!.start ?? null,
              end: e.data.onsen!.end ?? null,
              s: e.data.onsen!.seasonLabel ?? null,
            })),
          )}
        ></script>
      </div>
      <div class="onsen__art" aria-hidden="true">
        <svg class="steam" viewBox="0 0 140 160" fill="none">
          <path d="M40 155 C26 122 54 112 40 78 C30 54 52 42 40 12" />
          <path d="M72 158 C56 124 86 114 72 74 C60 46 84 34 72 8" />
          <path d="M104 155 C90 122 118 112 104 80 C94 56 116 44 104 16" />
        </svg>
      </div>
    </div>
  </Section>

  {/* ===== 06 READS 新着記事（編集カード・2列） ===== */}
  <Section
    index="06"
    label="Reads"
    title="新着記事"
    description="温泉の時期・ふれあい施設・カピバラの生態など、役立つ記事をお届けします。"
    moreHref="/articles/"
    class="band"
  >
    <div class="reads">
      {articles.map((a) => (
        <Card variant="editorial" class="reads__card" title={a.name} icon={a.icon} meta={a.tag} href="/articles/">
          公開準備中の記事です。SEO実測にもとづくラインナップで順次公開します。
        </Card>
      ))}
    </div>
  </Section>
</BaseLayout>

{/* 温泉ストリップの数字・文言を閲覧日で再集計（開催中件数のズレ対策） */}
<script>
  import { getOnsenCalStatus, isOnsenSeason } from '../lib/onsen';

  const dataEl = document.getElementById('onsen-strip-data');
  if (dataEl?.textContent) {
    try {
      const list = JSON.parse(dataEl.textContent) as { start: string | null; end: string | null; s: string | null }[];
      let active = 0;
      let permanent = 0;
      for (const o of list) {
        const st = getOnsenCalStatus({ start: o.start, end: o.end, seasonLabel: o.s }).status;
        if (st === 'permanent') permanent++;
        if (st === 'active' || st === 'soon-end' || st === 'soon-start') active++;
      }
      const seasonal = list.length - permanent;
      const inSeason = isOnsenSeason();

      const numEl = document.getElementById('onsen-stat-primary');
      const labelEl = document.getElementById('onsen-stat-primary-label');
      const leadEl = document.getElementById('onsen-strip-lead');
      if (inSeason && active > 0) {
        if (numEl) numEl.textContent = String(active);
        if (labelEl) labelEl.textContent = '園で開催中';
        if (leadEl)
          leadEl.textContent = `全国${active}園でカピバラ温泉が開催中。開催期間を横断のタイムラインで確認できます。`;
      } else {
        if (numEl) numEl.textContent = String(permanent);
        if (labelEl) labelEl.textContent = '園が通年営業';
        if (leadEl)
          leadEl.textContent = `いまはオフシーズン。通年で入れる${permanent}園に加え、冬に向けて全国${seasonal}園が発表待ちです。`;
      }
    } catch {
      /* 解析失敗時はビルド時の表示をそのまま使う */
    }
  }
</script>

{/* ライブ状態JSONを取得して 01 LIVE と 04 新着フィードをクライアント描画する */}
<script>
  import { LIVE_STATUS_URL, LIVE_STATUS_FALLBACK_URL } from '../config';

  type ChannelMeta = {
    name: string;
    embedOk: boolean | null;
    capybaraContent: boolean;
    facilitySlug: string | null;
    watchNote: string;
    tendency: string;
    country: string;
  };
  type LiveItem = { channelSlug: string | null; videoId: string; title: string; startedAt?: string | null };
  type FeedItem = {
    channelSlug: string;
    channelName: string;
    facilitySlug: string | null;
    videoId: string;
    title: string;
    published: string;
  };
  type Status = { updatedAt: string; degraded: boolean; live: LiveItem[]; upcoming: LiveItem[]; latestVideos: FeedItem[] };

  const channelsEl = document.getElementById('channels-data');
  const channels: Record<string, ChannelMeta> = channelsEl?.textContent ? JSON.parse(channelsEl.textContent) : {};

  // 再生ボタンの三角（Phosphor play-fill 相当・絵文字を使わない）
  const PLAY_SVG =
    '<svg viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M228.23 134.69 84.15 222.81A8 8 0 0 1 72 216V40a8 8 0 0 1 12.15-6.81l144.08 88.12a8 8 0 0 1 0 13.38Z"></path></svg>';

  const esc = (s: string): string => {
    const d = document.createElement('div');
    d.textContent = s ?? '';
    return d.innerHTML;
  };
  const thumb = (id: string): string => `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;

  function liveCardHtml(item: LiveItem): string {
    const ch = item.channelSlug ? channels[item.channelSlug] : undefined;
    const name = ch?.name ?? '配信チャンネル';
    const note = ch?.tendency || ch?.watchNote || 'カピバラのライブ配信です。';
    const title = item.title || name;
    const badge = '<span class="vcard__badge"><span class="live-badge"><span class="live-badge__dot"></span>LIVE</span></span>';
    if (ch && ch.embedOk === false) {
      // 埋め込み不可 → 「YouTubeで見る」外部リンクカード（フォールバック）
      const url = `https://www.youtube.com/watch?v=${item.videoId}`;
      return `<article class="vcard"><a class="vcard__media vcard__extlink" href="${url}" target="_blank" rel="noopener" aria-label="YouTubeで見る: ${esc(title)}"><img class="lyt__img" src="${thumb(item.videoId)}" alt="" loading="lazy" decoding="async" /><span class="lyt__scrim"></span><span class="vcard__ext">YouTubeで見る</span>${badge}</a><div class="vcard__body"><p class="vcard__meta label">${esc(name)}</p><h3 class="vcard__title">${esc(title)}</h3><p class="vcard__note">${esc(note)}</p></div></article>`;
    }
    // 埋め込み可 → lite-youtube facade
    return `<article class="vcard"><div class="vcard__media"><div class="lyt" role="button" tabindex="0" data-yt-facade data-video-id="${item.videoId}" style="--lyt-ratio:16 / 9;" aria-label="再生: ${esc(title)}"><img class="lyt__img" src="${thumb(item.videoId)}" alt="" loading="lazy" decoding="async" /><span class="lyt__scrim"></span><span class="lyt__play">${PLAY_SVG}</span></div>${badge}</div><div class="vcard__body"><p class="vcard__meta label">${esc(name)}</p><h3 class="vcard__title">${esc(title)}</h3><p class="vcard__note">${esc(note)}</p></div></article>`;
  }

  function feedCardHtml(item: FeedItem): string {
    const ch = channels[item.channelSlug];
    const name = item.channelName || ch?.name || '';
    const note = ch?.watchNote || 'カピバラの新着動画です。';
    const url = `https://www.youtube.com/watch?v=${item.videoId}`;
    const date = item.published
      ? new Date(item.published).toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' })
      : '';
    return `<a class="feed-card" href="${url}" target="_blank" rel="noopener" role="listitem"><span class="feed-card__media"><img class="feed-card__img" src="${thumb(item.videoId)}" alt="" loading="lazy" decoding="async" /></span><span class="feed-card__body"><span class="feed-card__meta label">${esc(name)}${date ? ` ・ ${date}` : ''}</span><span class="feed-card__title">${esc(item.title)}</span><span class="feed-card__note">${esc(note)}</span></span></a>`;
  }

  async function loadStatus(): Promise<Status | null> {
    const bust = `?t=${Date.now()}`;
    // ローカル開発（DEV）は公開前で remote が 404 になるためローカルのみ参照（コンソールエラー回避）。
    // 本番は data ブランチの raw を優先し、失敗時にローカルへフォールバック。
    // ただし LIVE_STATUS_URL が未設定（OWNER プレースホルダのまま＝P5前）の場合は
    // 確実に404になる remote 参照を避け、ローカルのみにする。
    const remoteConfigured = !LIVE_STATUS_URL.includes('OWNER/');
    const urls =
      import.meta.env.DEV || !remoteConfigured
        ? [LIVE_STATUS_FALLBACK_URL + bust]
        : [LIVE_STATUS_URL + bust, LIVE_STATUS_FALLBACK_URL + bust];
    for (const u of urls) {
      try {
        const res = await fetch(u, { cache: 'no-store' });
        if (res.ok) return (await res.json()) as Status;
      } catch {
        /* 次のURLへ */
      }
    }
    return null;
  }

  function renderLive(status: Status | null): void {
    const grid = document.getElementById('live-grid');
    const empty = document.getElementById('live-empty');
    const root = document.getElementById('live-root');
    if (!grid || !empty || !root) return;
    // カピバラが映るチャンネルのライブだけを対象（capybaraContent:false は除外＝非カピバラを装わない）
    const items = (status?.live ?? []).filter((x) => {
      const ch = x.channelSlug ? channels[x.channelSlug] : undefined;
      return ch && ch.capybaraContent;
    });
    if (items.length === 0) return; // 0件・fetch失敗 → 空状態のまま（既存挙動を維持）
    grid.innerHTML = items.map(liveCardHtml).join('');
    grid.hidden = false;
    empty.hidden = true;
    root.setAttribute('data-state', 'live');
  }

  function renderFeed(status: Status | null): void {
    const scroll = document.getElementById('feed-scroll');
    const fallback = document.getElementById('feed-fallback');
    if (!scroll || !fallback) return;
    const items = (status?.latestVideos ?? []).slice(0, 16);
    if (items.length === 0) {
      fallback.textContent = '新着動画を読み込めませんでした。時間をおいて再度お試しください。';
      return;
    }
    scroll.innerHTML = items.map(feedCardHtml).join('');
    scroll.hidden = false;
    fallback.hidden = true;
  }

  loadStatus().then((status) => {
    renderLive(status);
    renderFeed(status);
  });
</script>

<style>
  /* ============ ヒーロー ============ */
  .hero {
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }
  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-6);
    padding-block: clamp(3.5rem, 2.5rem + 6vw, 6.5rem);
  }
  .hero__content {
    max-width: 34rem;
  }
  .hero__eyebrow {
    margin: 0 0 var(--space-4);
    color: var(--accent-ink);
  }
  .hero__title {
    margin: 0 0 var(--space-5);
    font-size: clamp(2.4rem, 1.6rem + 4.2vw, 4rem);
    line-height: 1.22;
    letter-spacing: 0.04em;
    color: var(--text-1);
  }
  .hero__lead {
    margin: 0 0 var(--space-6);
    max-width: 42ch;
    color: var(--text-2);
    font-size: 1.0625rem;
    line-height: 1.9;
  }
  .hero__actions {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    flex-wrap: wrap;
  }
  .hero__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--text-1);
    font-weight: 500;
  }
  .hero__link :global(svg) {
    color: var(--accent);
    transition: transform var(--motion-fast);
  }
  .hero__link:hover {
    text-decoration: none;
    color: var(--accent-ink);
  }
  .hero__link:hover :global(svg) {
    transform: translateX(3px);
  }

  /* ヒーローの湯けむり＋縦ラベル */
  .hero__art {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding-right: var(--space-4);
  }
  .hero__vlabel {
    writing-mode: vertical-rl;
    color: var(--text-3);
    letter-spacing: 0.28em;
  }
  .steam {
    width: clamp(90px, 12vw, 140px);
    height: auto;
  }
  .steam path {
    stroke: var(--line-strong);
    stroke-width: 1.5;
    stroke-linecap: round;
  }
  .steam path:nth-child(1) { opacity: 0.55; }
  .steam path:nth-child(2) { opacity: 0.9; }
  .steam path:nth-child(3) { opacity: 0.7; }

  @media (max-width: 760px) {
    .hero__inner {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
    .hero__art {
      order: -1;
      justify-content: flex-start;
      padding: 0;
    }
    .hero__vlabel {
      display: none;
    }
    .steam--hero {
      width: 80px;
    }
  }

  /* ============ 帯（面の明度差でリズム） ============ */
  :global(.band) {
    background: var(--surface-soft);
  }

  /* ============ 01 LIVE 空状態 ============ */
  .live-empty {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    padding: var(--space-6);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
  }
  .live-empty__mascot {
    flex-shrink: 0;
  }
  .live-empty__title {
    margin: 0 0 var(--space-2);
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.1875rem;
    color: var(--text-1);
  }
  .live-empty__note {
    margin: 0 0 var(--space-3);
    color: var(--text-2);
    font-size: 0.9375rem;
  }
  .live-empty__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 500;
    color: var(--accent-ink);
  }
  .live-empty__link :global(svg) {
    transition: transform var(--motion-fast);
  }
  .live-empty__link:hover {
    text-decoration: none;
  }
  .live-empty__link:hover :global(svg) {
    transform: translateX(3px);
  }

  /* ============ 02 いつでも見られる（動画カードのグリッド） ============ */
  .always-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 264px), 1fr));
    gap: var(--space-4);
  }

  /* ============ 01 LIVE（クライアント描画のカードグリッド） ============ */
  .live-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: var(--space-4);
  }
  /* prefers-reduced-motion 環境でなければ、出現時に一度だけそっと持ち上げる */
  @media (prefers-reduced-motion: no-preference) {
    .live-grid:not([hidden]) :global(.vcard) {
      animation: live-reveal var(--motion-base) both;
    }
  }
  @keyframes live-reveal {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  /* ============ 03 番号付き編集リスト（アーカイブ・ファサード付き） ============ */
  .archive {
    display: flex;
    flex-direction: column;
  }
  .archive__row {
    display: grid;
    grid-template-columns: auto 172px 1fr;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-1);
    border-top: 1px solid var(--line);
  }
  .archive__row:last-child {
    border-bottom: 1px solid var(--line);
  }
  .archive__index {
    font-size: 1.5rem;
    color: var(--accent-ink);
    line-height: 1;
  }
  .archive__facade {
    border-radius: var(--radius-s);
  }
  .archive__body {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .archive__title {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.0625rem;
    color: var(--text-1);
  }
  .archive__src {
    margin: 0;
    color: var(--text-3);
  }
  .archive__note {
    margin: 0;
    color: var(--text-2);
    font-size: 0.875rem;
    line-height: 1.7;
  }

  @media (max-width: 560px) {
    .archive__row {
      grid-template-columns: auto 1fr;
      gap: var(--space-3);
    }
    .archive__facade {
      grid-column: 1 / -1;
    }
  }

  /* ============ 04 横スクロールカード（新着フィード） ============ */
  .feed-scroll {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(240px, 1fr);
    gap: var(--space-4);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: var(--space-3);
    margin-inline: calc(-1 * var(--space-5));
    padding-inline: var(--space-5);
    scrollbar-width: thin;
  }
  .feed-fallback {
    margin: 0;
    color: var(--text-3);
    font-size: 0.9375rem;
  }

  /* ============ 05 温泉ストリップ ============ */
  .onsen {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--space-5);
    padding: var(--space-6) var(--space-7);
    background: var(--surface-soft);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    overflow: hidden;
  }
  .onsen__title {
    margin: 0 0 var(--space-3);
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: clamp(1.25rem, 1.05rem + 1vw, 1.6rem);
    line-height: 1.45;
    color: var(--text-1);
  }
  /* 実データの状況（数字はFraunces） */
  .onsen__stats {
    display: flex;
    gap: var(--space-6);
    margin: 0 0 var(--space-4);
  }
  .onsen__stat {
    display: flex;
    align-items: baseline;
    gap: 6px;
  }
  .onsen__stat-num {
    font-size: clamp(1.9rem, 1.5rem + 1.6vw, 2.6rem);
    line-height: 1;
    color: var(--accent-ink);
  }
  .onsen__stat-label {
    color: var(--text-2);
    font-size: 0.875rem;
  }
  .onsen__note {
    margin: 0 0 var(--space-5);
    max-width: 52ch;
    color: var(--text-2);
    font-size: 0.9375rem;
  }
  .onsen__art .steam {
    width: clamp(80px, 10vw, 130px);
  }
  @media (max-width: 640px) {
    .onsen {
      grid-template-columns: 1fr;
      padding: var(--space-5);
    }
    .onsen__art {
      display: none;
    }
  }

  /* ============ 06 記事カード（2列） ============ */
  .reads {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: var(--space-4);
  }
</style>

