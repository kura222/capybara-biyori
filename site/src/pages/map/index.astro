{/* Leaflet が生成する要素・自作ピン・ポップアップはスコープ外のため is:global で装飾 */}
<style is:global>
  /* 自作ピン（種別でトークン色を割当。既定の青ピン画像は不使用） */
  .pin {
    display: block;
    width: 20px;
    height: 20px;
    border-radius: var(--radius-full);
    background: var(--pin-color, var(--accent));
    border: 2px solid var(--surface);
    box-shadow: 0 1px 3px hsl(33 30% 20% / 0.35);
    transition: transform var(--motion-fast);
