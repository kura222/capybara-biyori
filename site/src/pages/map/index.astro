---
/**
 * 全国カピバラマップ（/map/）— 仕様 §4.2。
 * - Leaflet + OSM のクライアント地図（JSはこのページでのみ読込）
 * - 種別で色分けした自作ピン（divIcon+CSSでトークン色を割当。既定の青ピン画像は使わない）
 * - フィルタチップ（温泉あり／ふれあい可／カフェ／ライブ配信あり）＋地方セレクタ＋閉園トグル
 * - 下部の編集的カード一覧（罫線1px流派）。地図とデータ属性で連動
 * デザインガイドライン §5（セクション見出しの型・カード2流派）に準拠。
 */
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import { typeMeta, regionLabel, sortRegions, TYPE_META } from '../../data/taxonomy';

// --- 施設の読み込み・整形 ---
const entries = await getCollection('facilities');

/** カード表示・フィルタ用に施設を整形（フィーチャーフラグを先に計算しておく） */
const facilities = entries
  .map((e) => {
    const d = e.data;
    const meta = typeMeta(d.type);
    return {
      id: e.id,
      name: d.name,
      type: d.type,
      typeLabel: meta.label,
      typeIcon: meta.icon,
      pinClass: meta.pinClass,
      prefecture: d.prefecture,
      region: d.region,
      regionLabel: regionLabel(d.region),
      lat: d.lat,
      lng: d.lng,
      latlngApprox: d.latlngApprox,
      status: d.status,
      officialUrl: d.officialUrl,
      detail: d.detail,
      fees: d.fees,
      // フィーチャーフラグ（フィルタ判定に使用）
      fOnsen: !!d.onsen?.has,
      fFureai: d.capybara?.fureai === true,
      fCafe: d.type === 'cafe' || d.hasCafe,
      fLive: !!d.live,
      // 詳細ページがある施設は詳細へ、無い施設は公式サイトへ
      url: d.detail ? `/spots/${e.id}/` : d.officialUrl,
    };
  })
  .sort((a, b) => a.name.localeCompare(b.name, 'ja'));

// 地方セレクタの選択肢（データに存在する地方のみ・北→南で整列）
const regionOptions = sortRegions(facilities.map((f) => f.region));

// フィルタチップ定義（デザインガイドライン: アイコンは Phosphor）
const chips = [
  { key: 'onsen', label: '温泉あり', icon: 'ph:drop' },
  { key: 'fureai', label: 'ふれあい可', icon: 'ph:hand-heart' },
  { key: 'cafe', label: 'カフェ', icon: 'ph:coffee' },
  { key: 'live', label: 'ライブ配信あり', icon: 'ph:broadcast' },
] as const;

// 凡例（地図に出現しうる全種別）
const legend = Object.entries(TYPE_META).map(([, m]) => ({
  label: m.label,
  pinClass: m.pinClass,
}));

// クライアント地図へ渡す最小データ（座標・種別・フラグ・リンク）
const mapData = facilities.map((f) => ({
  id: f.id,
  name: f.name,
  lat: f.lat,
  lng: f.lng,
  pinClass: f.pinClass,
  typeLabel: f.typeLabel,
  prefecture: f.prefecture,
  region: f.region,
  status: f.status,
  detail: f.detail,
  url: f.url,
  latlngApprox: f.latlngApprox,
  fOnsen: f.fOnsen,
  fFureai: f.fFureai,
  fCafe: f.fCafe,
  fLive: f.fLive,
}));

const statusLabel: Record<string, string> = {
  open: '',
  closed: '閉園',
  suspended: '休止中',
};
---

<BaseLayout
  title="全国カピバラマップ"
  description="カピバラに会える全国の動物園・水族館・カフェを地図と一覧でまとめます。温泉あり／ふれあい可などで絞り込み、閉園情報も明示します。"
>
  <Section
    index="01"
    label="Map"
    title="全国カピバラマップ"
    description="カピバラに会える施設を地図と一覧で。温泉・ふれあいなどで絞り込めます。座標が概算の施設は「およその位置」と表示します。"
    moreHref="/world/"
    moreLabel="海外の施設は世界マップへ"
  >
    <div class="mapview">
      {/* フィルタ */}
      <div class="filters" role="group" aria-label="施設の絞り込み">
        <div class="filters__chips" role="group" aria-label="設備で絞り込み">
          {
            chips.map((c) => (
              <button type="button" class="chip" data-filter={c.key} aria-pressed="false">
                <Icon name={c.icon} class="chip__icon" aria-hidden="true" />
                <span>{c.label}</span>
              </button>
            ))
          }
        </div>

        <div class="filters__side">
          <label class="field">
            <span class="field__label">地方</span>
            <span class="field__select">
              <select id="region-select" aria-label="地方で絞り込み">
                <option value="all">すべての地方</option>
                {regionOptions.map((r) => <option value={r}>{regionLabel(r)}</option>)}
              </select>
              <Icon name="ph:caret-down" aria-hidden="true" />
            </span>
          </label>

          <label class="toggle">
            <input type="checkbox" id="show-closed" />
            <span>閉園・休止も表示</span>
          </label>
        </div>
      </div>

      {/* 現在地から探す（位置情報は端末内でのみ利用・送信/保存しない） */}
      <div class="geobar">
        <div class="geobar__actions">
          <button type="button" class="btn-locate" id="locate-btn">
            <Icon name="ph:crosshair" class="btn-locate__icon" aria-hidden="true" />
            <span>現在地から探す</span>
          </button>
          <button type="button" class="btn-back" id="reset-region-btn" hidden>
            <Icon name="ph:globe-hemisphere-west" aria-hidden="true" />
            <span>全国表示に戻す</span>
          </button>
        </div>
        <p class="geobar__privacy">
          <Icon name="ph:lock-simple" aria-hidden="true" />
          位置情報はお使いの端末内でのみ使われ、送信・保存されません。
        </p>
        <p class="geo-msg" id="geo-msg" role="status" aria-live="polite" hidden></p>
      </div>

      {/* 地図 */}
      <div class="map-wrap">
        <div id="map" class="map" role="application" aria-label="カピバラ施設の地図">
          <p class="map__fallback">地図を読み込んでいます…（読み込めない場合も、下の一覧から施設を探せます）</p>
        </div>
        <ul class="legend" aria-label="ピンの色と種別">
          {
            legend.map((l) => (
              <li class="legend__item">
                <span class={`pin pin--legend ${l.pinClass}`} aria-hidden="true" />
                <span>{l.label}</span>
              </li>
            ))
          }
        </ul>
      </div>

      {/* 一覧のメタ（件数・並び替え） */}
      <div class="listmeta">
        <p class="listmeta__count">
          <span id="result-count" class="num">{facilities.length}</span>
          <span>件の施設</span>
        </p>
        <div class="sortmode" id="sortmode" role="group" aria-label="並び替え" hidden>
          <button type="button" class="sortmode__btn" data-sort="near" aria-pressed="true">近い順</button>
          <button type="button" class="sortmode__btn" data-sort="region" aria-pressed="false">地域順</button>
        </div>
      </div>

      {/* カード一覧（編集的カード=罫線1px流派） */}
      <ul class="facil-list" id="facil-list">
        {
          facilities.map((f) => (
            <li
              class:list={['facil', { 'facil--muted': f.status !== 'open', 'facil--simple': !f.detail }]}
              data-id={f.id}
              data-region={f.region}
              data-type={f.type}
              data-status={f.status}
              data-onsen={String(f.fOnsen)}
              data-fureai={String(f.fFureai)}
              data-cafe={String(f.fCafe)}
              data-live={String(f.fLive)}
            >
              <div class="facil__head">
                <span class="facil__type">
                  <Icon name={f.typeIcon} aria-hidden="true" />
                  {f.typeLabel}
                </span>
                {f.status !== 'open' && <span class="facil__status">{statusLabel[f.status]}</span>}
              </div>

              <h3 class="facil__name">
                {f.url ? (
                  <a href={f.url}>
                    {f.name}
                    {!f.detail && <Icon name="ph:arrow-square-out" class="facil__extlink" aria-hidden="true" />}
                  </a>
                ) : (
                  <span>{f.name}</span>
                )}
              </h3>

              <p class="facil__pref">
                <Icon name="ph:map-pin" aria-hidden="true" />
                {f.prefecture}
                {f.latlngApprox && <span class="facil__approx">おおよその位置</span>}
                <span class="facil__dist" hidden aria-hidden="true"></span>
              </p>

              {f.detail && (
                <>
                  {(f.fOnsen || f.fFureai || f.fCafe || f.fLive) && (
                    <ul class="ftags" aria-label="設備">
                      {f.fOnsen && (
                        <li class="ftag">
                          <Icon name="ph:drop" aria-hidden="true" />
                          温泉
                        </li>
                      )}
                      {f.fFureai && (
                        <li class="ftag">
                          <Icon name="ph:hand-heart" aria-hidden="true" />
                          ふれあい
                        </li>
                      )}
                      {f.fCafe && (
                        <li class="ftag">
                          <Icon name="ph:coffee" aria-hidden="true" />
                          カフェ
                        </li>
                      )}
                      {f.fLive && (
                        <li class="ftag">
                          <Icon name="ph:broadcast" aria-hidden="true" />
                          配信
                        </li>
                      )}
                    </ul>
                  )}
                  {f.fees.length > 0 && (
                    <p class="facil__fee">
                      <span class="facil__fee-label">料金</span>
                      <span class="num">{f.fees[0].price}</span>
                      <span class="facil__fee-note">（{f.fees[0].label}）</span>
                    </p>
                  )}
                </>
              )}

              {!f.detail && <p class="facil__simple-note">詳細情報は準備中です。公式サイトをご確認ください。</p>}
            </li>
          ))
        }
      </ul>

      {/* 絞り込み結果ゼロ時の空状態 */}
      <p class="facil-empty" id="facil-empty" hidden>
        <Icon name="ph:magnifying-glass" aria-hidden="true" />
        条件に合う施設が見つかりませんでした。フィルタを外すと表示されます。
      </p>
    </div>
  </Section>

  {/* 地図の現在地コントロール用アイコン（Phosphor SVG をクライアントで複製） */}
  <template id="tmpl-locate-icon"><Icon name="ph:crosshair" aria-hidden="true" /></template>

  {/* クライアント地図へ渡すデータ（JSON） */}
  <script type="application/json" id="facilities-data" is:inline set:html={JSON.stringify(mapData)}></script>
</BaseLayout>

{/* 地図とフィルタのクライアント処理（このページでのみ Leaflet を読込） */}
<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';
  import { REGION_ORDER } from '../../data/taxonomy';

  type Facility = {
    id: string;
    name: string;
    lat: number | null;
    lng: number | null;
    pinClass: string;
    typeLabel: string;
    prefecture: string;
    region: string;
    status: string;
    detail: boolean;
    url: string | null;
    latlngApprox: boolean;
    fOnsen: boolean;
    fFureai: boolean;
    fCafe: boolean;
    fLive: boolean;
  };

  const dataEl = document.getElementById('facilities-data');
  const mapEl = document.getElementById('map');
  if (dataEl && mapEl) {
    const facilities: Facility[] = JSON.parse(dataEl.textContent || '[]');

    // --- 地図の初期化（日本全体） ---
    mapEl.innerHTML = '';
    const map = L.map(mapEl, {
      scrollWheelZoom: false, // 誤スクロール防止（フォーカス時のみ有効化）
      zoomControl: true,
      // ズームアニメーション無効: transitionendが発火しない環境（非表示タブ・
      // ヘッドレス等）で _animatingZoom フラグが残留し、以後の setView が無視され
      // タイル更新まで止まる Leaflet の既知の挙動を実測で確認。アニメーションを
      // 切ることでこの問題のクラスごと根絶する（ズームは即時切替になる）。
      zoomAnimation: false,
    }).setView([37.5, 137.5], 5);

    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution:
        '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a> contributors',
      maxZoom: 18,
    }).addTo(map);

    map.on('focus', () => map.scrollWheelZoom.enable());
    map.on('blur', () => map.scrollWheelZoom.disable());

    // --- マーカー（自作 divIcon・トークン色） ---
    const records = new Map<string, { marker: L.Marker; data: Facility }>();
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c] as string);

    for (const f of facilities) {
      // 座標が無い施設はピンを打たない（下のカード一覧のみに出す）
      if (f.lat == null || f.lng == null) continue;
      const icon = L.divIcon({
        className: 'pin-icon',
        html: `<span class="pin ${f.pinClass}"></span>`,
        iconSize: [22, 22],
        iconAnchor: [11, 11],
        popupAnchor: [0, -12],
      });
      const marker = L.marker([f.lat, f.lng], { icon, title: f.name, keyboard: true });
      const approx = f.latlngApprox ? '<span class="pin-popup__approx">おおよその位置</span>' : '';
      const linkLabel = f.detail ? '詳細を見る' : '公式サイトを見る';
      // 公式サイト未確認の簡易施設（url=null）はリンクを出さない
      const linkHtml = f.url
        ? `<a class="pin-popup__link" href="${esc(f.url)}">${linkLabel} →</a>`
        : '';
      marker.bindPopup(
        `<div class="pin-popup">
          <p class="pin-popup__type">${esc(f.typeLabel)}・${esc(f.prefecture)}</p>
          <p class="pin-popup__name">${esc(f.name)}</p>
          ${approx}
          ${linkHtml}
        </div>`,
      );
      records.set(f.id, { marker, data: f });
    }

    // --- フィルタ ---
    const chipEls = Array.from(document.querySelectorAll<HTMLButtonElement>('.chip'));
    const regionSel = document.getElementById('region-select') as HTMLSelectElement | null;
    const showClosed = document.getElementById('show-closed') as HTMLInputElement | null;
    const countEl = document.getElementById('result-count');
    const emptyEl = document.getElementById('facil-empty');

    function activeChips(): Set<string> {
      const set = new Set<string>();
      for (const c of chipEls) {
        if (c.getAttribute('aria-pressed') === 'true' && c.dataset.filter) set.add(c.dataset.filter);
      }
      return set;
    }

    function matches(f: Facility): boolean {
      const active = activeChips();
      const region = regionSel?.value ?? 'all';
      const closedVisible = showClosed?.checked ?? false;
      if (!closedVisible && f.status !== 'open') return false;
      if (region !== 'all' && f.region !== region) return false;
      // アクティブなチップはすべて満たす必要がある（AND）
      if (active.has('onsen') && !f.fOnsen) return false;
      if (active.has('fureai') && !f.fFureai) return false;
      if (active.has('cafe') && !f.fCafe) return false;
      if (active.has('live') && !f.fLive) return false;
      return true;
    }

    function apply() {
      let count = 0;
      for (const f of facilities) {
        const ok = matches(f);
        const card = document.querySelector<HTMLElement>(`.facil[data-id="${f.id}"]`);
        if (card) card.hidden = !ok;
        const rec = records.get(f.id);
        if (rec) {
          if (ok) {
            if (!map.hasLayer(rec.marker)) rec.marker.addTo(map);
          } else if (map.hasLayer(rec.marker)) {
            map.removeLayer(rec.marker);
          }
        }
        if (ok) count++;
      }
      if (countEl) countEl.textContent = String(count);
      if (emptyEl) emptyEl.hidden = count !== 0;
    }

    for (const c of chipEls) {
      c.addEventListener('click', () => {
        const pressed = c.getAttribute('aria-pressed') === 'true';
        c.setAttribute('aria-pressed', String(!pressed));
        apply();
      });
    }
    regionSel?.addEventListener('change', apply);
    showClosed?.addEventListener('change', apply);

    // --- 一覧カード → 地図の連動（ホバーでポップアップ、クリックで寄せる） ---
    for (const f of facilities) {
      const card = document.querySelector<HTMLElement>(`.facil[data-id="${f.id}"]`);
      const rec = records.get(f.id);
      if (!card || !rec) continue;
      card.addEventListener('mouseenter', () => {
        if (map.hasLayer(rec.marker)) rec.marker.openPopup();
      });
    }

    // ===== 現在地から探す（位置情報は端末内でのみ利用・送信/保存しない） =====
    const GEO_FLAG = 'capybara-geo-allowed';
    const locateBtn = document.getElementById('locate-btn') as HTMLButtonElement | null;
    const resetBtn = document.getElementById('reset-region-btn') as HTMLButtonElement | null;
    const geoMsg = document.getElementById('geo-msg');
    const sortmodeEl = document.getElementById('sortmode');
    const sortBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.sortmode__btn'));
    const listEl = document.getElementById('facil-list');

    let userMarker: L.Marker | null = null;
    let accuracyCircle: L.Circle | null = null;
    let hasLocation = false;
    let sortMode: 'near' | 'region' = 'near';
    const distances = new Map<string, number>(); // id → km（座標ありのみ）

    const regionRank = (r: string) => {
      const i = REGION_ORDER.indexOf(r);
      return i === -1 ? REGION_ORDER.length : i;
    };

    // ハーバサイン距離（km・クライアント計算・依存追加なし）
    function haversineKm(aLat: number, aLng: number, bLat: number, bLng: number): number {
      const R = 6371;
      const toRad = (d: number) => (d * Math.PI) / 180;
      const dLat = toRad(bLat - aLat);
      const dLng = toRad(bLng - aLng);
      const s =
        Math.sin(dLat / 2) ** 2 +
        Math.cos(toRad(aLat)) * Math.cos(toRad(bLat)) * Math.sin(dLng / 2) ** 2;
      return 2 * R * Math.asin(Math.min(1, Math.sqrt(s)));
    }
    const fmtDist = (km: number) => `約${Math.max(1, Math.round(km))}km`;

    function showMsg(text: string) {
      if (!geoMsg) return;
      geoMsg.textContent = text;
      geoMsg.hidden = !text;
    }

    // 全国表示（可視ピンに地図を合わせる）
    function fitNational() {
      const vis = facilities.filter((f) => matches(f) && f.lat != null && f.lng != null);
      if (vis.length > 0) {
        const b = L.latLngBounds(
          vis.map((f) => [f.lat as number, f.lng as number] as [number, number]),
        );
        map.fitBounds(b, { padding: [48, 48], maxZoom: 7 });
      } else {
        map.setView([37.5, 137.5], 5);
      }
    }

    // カード一覧の並び替え（DOM の並べ替え・textContent のみ使用）
    function orderCards() {
      if (!listEl) return;
      const byId = new Map<string, Facility>(facilities.map((f) => [f.id, f]));
      const cards = Array.from(listEl.querySelectorAll<HTMLElement>('.facil'));
      cards.sort((ca, cb) => {
        const a = byId.get(ca.dataset.id || '');
        const b = byId.get(cb.dataset.id || '');
        if (!a || !b) return 0;
        if (sortMode === 'near') {
          const da = distances.has(a.id) ? (distances.get(a.id) as number) : Infinity;
          const db = distances.has(b.id) ? (distances.get(b.id) as number) : Infinity;
          if (da !== db) return da - db;
          return a.name.localeCompare(b.name, 'ja');
        }
        const ra = regionRank(a.region);
        const rb = regionRank(b.region);
        if (ra !== rb) return ra - rb;
        return a.name.localeCompare(b.name, 'ja');
      });
      for (const c of cards) listEl.appendChild(c);
    }

    // 各カードの距離バッジを更新（textContent のみ）
    function updateDistanceLabels() {
      for (const f of facilities) {
        const card = document.querySelector<HTMLElement>(`.facil[data-id="${f.id}"]`);
        const span = card?.querySelector<HTMLElement>('.facil__dist');
        if (!span) continue;
        if (hasLocation && distances.has(f.id)) {
          span.textContent = fmtDist(distances.get(f.id) as number);
          span.hidden = false;
        } else {
          span.textContent = '';
          span.hidden = true;
        }
      }
    }

    function setSortMode(mode: 'near' | 'region') {
      sortMode = mode;
      for (const b of sortBtns) b.setAttribute('aria-pressed', String(b.dataset.sort === mode));
      orderCards();
    }

    function onGeoSuccess(pos: GeolocationPosition) {
      const { latitude, longitude, accuracy } = pos.coords;
      hasLocation = true;
      showMsg('');
      try {
        localStorage.setItem(GEO_FLAG, '1');
      } catch {}

      // 距離を計算（座標のある施設のみ・座標なしは末尾扱い）
      distances.clear();
      for (const f of facilities) {
        if (f.lat != null && f.lng != null) {
          distances.set(f.id, haversineKm(latitude, longitude, f.lat, f.lng));
        }
      }

      // ユーザー位置マーカー（青ドット＋精度円。カピバラピンと区別）
      if (userMarker) map.removeLayer(userMarker);
      if (accuracyCircle) map.removeLayer(accuracyCircle);
      const uicon = L.divIcon({
        className: 'user-loc-icon',
        html: '<span class="user-loc-dot"></span>',
        iconSize: [20, 20],
        iconAnchor: [10, 10],
      });
      userMarker = L.marker([latitude, longitude], {
        icon: uicon,
        keyboard: false,
        title: '現在地',
        zIndexOffset: 1000,
      }).addTo(map);
      userMarker.bindPopup('<div class="pin-popup"><p class="pin-popup__name">現在地</p></div>');
      accuracyCircle = L.circle([latitude, longitude], {
        radius: Math.min(accuracy || 0, 20000),
        className: 'user-accuracy',
        interactive: false,
      }).addTo(map);

      // 近い順に並べ替え・距離表示・並び替えトグルを表示
      setSortMode('near');
      updateDistanceLabels();
      if (sortmodeEl) sortmodeEl.hidden = false;
      if (resetBtn) resetBtn.hidden = false;
      if (locateBtn) locateBtn.setAttribute('aria-pressed', 'true');

      // 地図を現在地中心へ（周辺に施設が少なくても最寄り3件が入るよう自動調整）
      const near = facilities
        .filter((f) => matches(f) && f.lat != null && f.lng != null)
        .sort((a, b) => (distances.get(a.id) as number) - (distances.get(b.id) as number))
        .slice(0, 3);
      const pts: [number, number][] = [[latitude, longitude]];
      for (const f of near) pts.push([f.lat as number, f.lng as number]);
      // ページ読込直後の自動開始では地図コンテナのサイズ確定前に届くことがあり、
      // そのままfitBoundsするとズーム計算が狂う（全国表示のままに見える）。
      // サイズを再計算してから1フレーム遅らせて確実に寄せる。
      // reset:true が重要: Leafletは既存のズームアニメーション実行中に setView/fitBounds を
      // 呼ぶと「何もせず成功を装って返す」（_tryAnimatedZoom の短絡）。初期の全国fitの
      // アニメーション残留と競合し、現在地ズームが無視される事象を実測で確認済み。
      // reset:true はアニメーション機構を完全にバイパスして確実にビューを適用する。
      setTimeout(() => {
        map.invalidateSize();
        if (pts.length > 1) {
          const b = L.latLngBounds(pts);
          const z = Math.min(10, map.getBoundsZoom(b, false, L.point(60, 60)));
          map.setView(b.getCenter(), z, { reset: true, animate: false });
        } else {
          map.setView([latitude, longitude], 10, { reset: true, animate: false });
        }
      }, 60);
    }

    function onGeoError(err: GeolocationPositionError) {
      // 拒否・失敗時は全国表示のまま・控えめに知らせる
      if (err && err.code === err.PERMISSION_DENIED) {
        try {
          localStorage.removeItem(GEO_FLAG);
        } catch {}
        showMsg('位置情報の利用が許可されませんでした。全国表示のままご利用いただけます。');
      } else {
        showMsg('現在地を取得できませんでした。全国表示のままご利用いただけます。');
      }
      if (locateBtn) {
        locateBtn.disabled = false;
        locateBtn.removeAttribute('aria-busy');
      }
    }

    function requestLocation() {
      if (!('geolocation' in navigator)) {
        showMsg('お使いの環境では位置情報を利用できません。全国表示でご利用ください。');
        return;
      }
      showMsg('');
      if (locateBtn) {
        locateBtn.disabled = true;
        locateBtn.setAttribute('aria-busy', 'true');
      }
      navigator.geolocation.getCurrentPosition(
        (pos) => {
          if (locateBtn) {
            locateBtn.disabled = false;
            locateBtn.removeAttribute('aria-busy');
          }
          onGeoSuccess(pos);
        },
        onGeoError,
        { enableHighAccuracy: false, timeout: 10000, maximumAge: 300000 },
      );
    }

    function resetToNational() {
      hasLocation = false;
      distances.clear();
      try {
        localStorage.removeItem(GEO_FLAG);
      } catch {}
      if (userMarker) {
        map.removeLayer(userMarker);
        userMarker = null;
      }
      if (accuracyCircle) {
        map.removeLayer(accuracyCircle);
        accuracyCircle = null;
      }
      updateDistanceLabels();
      setSortMode('region');
      if (sortmodeEl) sortmodeEl.hidden = true;
      if (resetBtn) resetBtn.hidden = true;
      if (locateBtn) locateBtn.setAttribute('aria-pressed', 'false');
      showMsg('');
      fitNational();
    }

    // 地図上の現在地コントロール（Google マップ風の ⌖ ボタン・Phosphor アイコン）
    const LocateControl = L.Control.extend({
      options: { position: 'topleft' as L.ControlPosition },
      onAdd() {
        const div = L.DomUtil.create('div', 'leaflet-bar leaflet-control locate-control');
        const a = L.DomUtil.create('a', '', div) as HTMLAnchorElement;
        a.href = '#';
        a.setAttribute('role', 'button');
        a.title = '現在地から探す';
        a.setAttribute('aria-label', '現在地から探す');
        const tmpl = document.getElementById('tmpl-locate-icon') as HTMLTemplateElement | null;
        if (tmpl) a.innerHTML = tmpl.innerHTML; // 自前の Phosphor SVG のみ（外部由来の文字列ではない）
        L.DomEvent.on(a, 'click', (e: Event) => {
          L.DomEvent.stop(e);
          requestLocation();
        });
        return div;
      },
    });
    map.addControl(new LocateControl());

    // ボタン・トグルの配線
    locateBtn?.addEventListener('click', requestLocation);
    resetBtn?.addEventListener('click', resetToNational);
    for (const b of sortBtns) {
      b.addEventListener('click', () => setSortMode(b.dataset.sort === 'region' ? 'region' : 'near'));
    }

    // ===== 初期描画 =====
    apply();
    fitNational();
    // 前回「位置利用を許可」していれば自動で現在地から開始（座標は保存していない）
    let autoGeo = false;
    try {
      autoGeo = localStorage.getItem(GEO_FLAG) === '1';
    } catch {}
    if (autoGeo) requestLocation();
    // レイアウト確定後にサイズを再計算（コンテナ高さ確定のズレ対策）
    setTimeout(() => map.invalidateSize(), 0);
  }
</script>

