---
/**
 * 全国カピバラマップ（/map/）— P0 は準備中プレースホルダー。
 * 地図（Leaflet）・フィルタ・施設一覧の実装は P1。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ComingSoon from '../../components/ComingSoon.astro';
---

<BaseLayout
  title="全国カピバラマップ"
  description="カピバラに会える全国の動物園・水族館・カフェを地図と一覧でまとめます。温泉あり／ふれあい可などで絞り込み。"
>
  <ComingSoon
    title="全国カピバラマップ"
    lead="カピバラに会える全国の動物園・水族館・カフェを、地図とカード一覧で探せるページです。施設データを一件ずつ公式サイトで確認しながら整備しています。"
    points={[
      '地図＋一覧のハイブリッド表示（都道府県・地方で絞り込み）',
      '「温泉あり／ふれあい可／カフェ／ライブ配信あり」のフィルタ',
      '閉園・休止情報も明示（情報の鮮度を大切にします）',
    ]}
    altHref="/onsen/"
    altLabel="温泉ごよみを見る"
  />
</BaseLayout>
