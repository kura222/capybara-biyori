  .pin-icon:hover .pin {
    transform: scale(1.25);
  }
  .pin--zoo {
    --pin-color: var(--green);
  }
  .pin--aquarium {
    --pin-color: var(--accent);
  }
  .pin--cafe {
    --pin-color: var(--accent-strong);
  }
  .pin--farm {
    --pin-color: var(--text-2);
