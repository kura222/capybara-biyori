---
/**
 * 制度ページ（about / privacy）共通の体裁。
 * - 雑誌的な見出し（Fraunces ラベル＋明朝 h1）＋制定/更新日
 * - 本文は slot（.doc-prose で見出し・リスト・注記ボックスを整える）
 * デザインガイドライン §4/§5 準拠（明朝見出し・生成り面・罫線区切り・影なし）。
 *
 * Props:
 *   - label:   欧文小ラベル（"About" 等）
 *   - title:   ページ見出し
 *   - lead:    リード文（任意）
 *   - date:    制定日/最終更新日の表示文字列（任意）
 *   - dateLabel: 日付の見出し（既定「最終更新」）
 */
import { Icon } from 'astro-icon/components';

interface Props {
  label: string;
  title: string;
  lead?: string;
  date?: string;
  dateLabel?: string;
}

const { label, title, lead, date, dateLabel = '最終更新' } = Astro.props;
---

<article class="doc container container--text">
  <header class="doc__head">
    <p class="doc__kicker label">
      <span class="doc__rule" aria-hidden="true"></span>
      <span>{label}</span>
    </p>
    <h1 class="doc__title">{title}</h1>
    {lead && <p class="doc__lead">{lead}</p>}
    {date && (
      <p class="doc__date">
        <Icon name="ph:calendar-blank" aria-hidden="true" />
        {dateLabel} <span class="num">{date}</span>
      </p>
    )}
  </header>

  <div class="doc-prose">
    <slot />
  </div>
</article>

<style>
  .doc {
    padding-block: var(--space-section-m) var(--space-section-s);
  }
  .doc__head {
    margin-bottom: var(--space-7);
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--line);
  }
  .doc__kicker {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 var(--space-3);
    color: var(--accent-ink);
  }
  .doc__rule {
    width: 28px;
    height: 1px;
    background: var(--accent);
    opacity: 0.7;
  }
  .doc__title {
    margin: 0 0 var(--space-4);
  }
  .doc__lead {
    margin: 0 0 var(--space-4);
    color: var(--text-2);
    font-size: 1.0625rem;
    line-height: 1.85;
  }
  .doc__date {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin: 0;
    color: var(--text-3);
    font-size: 0.8125rem;
  }
  .doc__date :global(svg) {
    color: var(--accent);
    font-size: 1.05em;
  }
</style>

<style is:global>
  /* 制度ページ本文（about/privacy）。記事の .prose と別系統でシンプルに整える。 */
  .doc-prose {
    color: var(--text-1);
    font-size: 1rem;
    line-height: 1.9;
  }
  .doc-prose section {
    margin-bottom: var(--space-7);
  }
  .doc-prose h2 {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 var(--space-4);
    font-size: 1.3rem;
    scroll-margin-top: calc(var(--header-height) + var(--space-4));
  }
  .doc-prose h2 :global(svg),
  .doc-prose h2 [data-icon] {
    color: var(--accent);
    font-size: 1.05em;
  }
  .doc-prose h3 {
    margin: var(--space-5) 0 var(--space-2);
    font-size: 1.05rem;
  }
  .doc-prose p {
    margin: 0 0 var(--space-4);
    color: var(--text-1);
  }
  .doc-prose a {
    color: var(--accent-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--line-strong);
  }
  .doc-prose a:hover {
    text-decoration-color: var(--accent);
  }
  .doc-prose strong {
    font-weight: 700;
  }
  .doc-prose ul {
    margin: 0 0 var(--space-4);
    padding-left: 1.35em;
    list-style: disc;
  }
  .doc-prose li {
    margin-bottom: var(--space-2);
    line-height: 1.8;
  }
  .doc-prose li::marker {
    color: var(--accent);
  }
  /* 注記・窓口ボックス（親しみカード寄り・影なし） */
  .doc-note {
    margin: 0 0 var(--space-4);
    padding: var(--space-5);
    background: var(--surface-soft);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
  }
  .doc-note > :last-child {
    margin-bottom: 0;
  }
  .doc-note__title {
    margin: 0 0 var(--space-2) !important;
    font-size: 1.0625rem !important;
  }
</style>
