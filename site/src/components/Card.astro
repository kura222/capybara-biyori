---
/**
 * カード（デザインガイドライン §5・2流派）。
 *   - editorial（編集的カード・施設/記事）: 罫線1px＋角丸s＋影なし。
 *       hover=サムネ1.03倍ズーム＋罫線・見出しが accent 化（薄暗くするだけ禁止）
 *   - friendly（親しみカード・ライブ/カレンダー系）: 面色 surface-soft＋角丸m＋影なし。
 *       hover=--shadow-2 のみ
 *
 * Props:
 *   - variant:  'editorial' | 'friendly'
 *   - title:    見出し
 *   - icon:     サムネ領域のプレースホルダーアイコン（Phosphor名）
 *   - meta:     サムネ下・見出し上の小ラベル（任意・欧文or短文）
 *   - badgeText/badgeVariant/badgeDot: サムネ上のステータスバッジ（任意）
 *   - href:     指定時はカード全体をリンク化
 *   - class
 * 本文は default スロット。
 */
import { Icon } from 'astro-icon/components';
import Badge from './Badge.astro';

interface Props {
  variant?: 'editorial' | 'friendly';
  title: string;
  icon?: string;
  meta?: string;
  badgeText?: string;
  badgeVariant?: 'live' | 'ok' | 'warn' | 'neutral' | 'accent';
  badgeDot?: boolean;
  href?: string;
  class?: string;
}

const {
  variant = 'editorial',
  title,
  icon = 'ph:video-camera',
  meta,
  badgeText,
  badgeVariant = 'neutral',
  badgeDot = false,
  href,
  class: className = '',
} = Astro.props;

const Tag = href ? 'a' : 'article';
---

<Tag
  class:list={['card', `card--${variant}`, { 'card--link': href }, className]}
  {...href ? { href } : {}}
>
  <div class="card__thumb">
    <div class="card__thumb-inner" aria-hidden="true">
      <Icon name={icon} class="card__thumb-icon" />
    </div>
    {badgeText && (
      <span class="card__badge">
        <Badge variant={badgeVariant} dot={badgeDot}>{badgeText}</Badge>
      </span>
    )}
  </div>
  <div class="card__body">
    {meta && <p class="card__meta label">{meta}</p>}
    <h3 class="card__title">{title}</h3>
    <div class="card__text">
      <slot />
    </div>
  </div>
</Tag>

<style>
  .card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    color: var(--text-1);
  }
  .card--link {
    text-decoration: none;
  }

  /* サムネ（16:9のメディアプレースホルダー） */
  .card__thumb {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--surface-soft);
  }
  .card__thumb-inner {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background:
      radial-gradient(90% 90% at 50% 20%, var(--surface) 0%, var(--surface-soft) 100%);
    transition: transform var(--motion-base);
  }
  .card__thumb-icon {
    font-size: 2.4rem;
    color: var(--line-strong);
  }
  .card__badge {
    position: absolute;
    left: 10px;
    top: 10px;
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4);
    flex: 1;
  }
  .card__meta {
    margin: 0;
    color: var(--accent-ink);
  }
  .card__title {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.4;
    color: var(--text-1);
    transition: color var(--motion-fast);
  }
  .card__text {
    color: var(--text-2);
    font-size: 0.875rem;
    line-height: 1.7;
  }
  .card__text :global(p:last-child) {
    margin-bottom: 0;
  }

  /* ---- 流派a: 編集的カード ---- */
  .card--editorial {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-s);
    transition: border-color var(--motion-fast);
  }
  .card--editorial.card--link:hover {
    border-color: var(--accent);
  }
  .card--editorial.card--link:hover .card__thumb-inner {
    transform: scale(1.03);
  }
  .card--editorial.card--link:hover .card__title {
    color: var(--accent-ink);
  }

  /* ---- 流派b: 親しみカード ---- */
  .card--friendly {
    background: var(--surface-soft);
    border: 1px solid transparent;
    border-radius: var(--radius-m);
    transition: box-shadow var(--motion-base);
  }
  .card--friendly .card__thumb {
    background: color-mix(in srgb, var(--surface-soft) 70%, var(--surface));
  }
  .card--friendly.card--link:hover {
    box-shadow: var(--shadow-2);
  }
</style>
