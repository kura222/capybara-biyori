---
/**
 * ステータスバッジ（ライブ中・開催中/稼働中・まもなく終了・中立・アクセント）。
 * variant で配色を切り替える。ピル形状（--radius-full）。
 */
interface Props {
  variant?: 'live' | 'ok' | 'warn' | 'neutral' | 'accent';
  /** 先頭に小さな丸ドットを表示するか（ライブ表示などで使用） */
  dot?: boolean;
  class?: string;
}

const { variant = 'neutral', dot = false, class: className = '' } = Astro.props;
---

<span class:list={['badge', `badge--${variant}`, className]}>
  {dot && <span class="badge__dot" aria-hidden="true"></span>}
  <slot />
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 10px;
    border-radius: var(--radius-full);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .badge__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
  }

  .badge--live {
    color: var(--live);
    background: var(--live-soft);
  }
  /* ライブ中ドットはゆっくり点滅（reduce-motion 環境では停止） */
  .badge--live .badge__dot {
    animation: badge-pulse 1.6s ease-in-out infinite;
  }

  .badge--ok {
    color: var(--green);
    background: var(--green-soft);
  }
  .badge--warn {
    color: var(--accent-ink);
    background: var(--accent-soft);
  }
  .badge--neutral {
    color: var(--text-2);
    background: var(--surface-soft);
  }
  .badge--accent {
    color: var(--text-on-accent);
    background: var(--cta-bg);
  }

  @keyframes badge-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }
</style>
