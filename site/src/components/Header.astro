---
/**
 * サイト共通ヘッダー（デザインガイドライン §7）。
 * - 影なし・下罫線で区切る・ぼかし背景（ヘッダー影は禁止）
 * - ロゴ = マスコット小 ＋ 明朝ワードマーク
 * - グローバルナビ（目的起点の文言＋Phosphorアイコン）
 * - ダークモード切替
 * 現在のパスと一致するナビ項目に aria-current を付与する。
 */
import { Icon } from 'astro-icon/components';
import { SITE, NAV_ITEMS } from '../config';
import Mascot from './Mascot.astro';
import ThemeToggle from './ThemeToggle.astro';

// 末尾スラッシュを吸収して現在ページ判定
const current = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => {
  const h = href.replace(/\/+$/, '') || '/';
  return h === '/' ? current === '/' : current === h || current.startsWith(h + '/');
};
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="logo" href="/" aria-label={`${SITE.name} ホーム`}>
      <Mascot size={30} steam={false} class="logo__mark" />
      <span class="logo__text">{SITE.name}</span>
    </a>

    <nav class="site-nav" aria-label="メインナビゲーション">
      <ul class="site-nav__list">
        {
          NAV_ITEMS.map((item) => (
            <li>
              <a
                class="site-nav__link"
                href={item.href}
                {...isActive(item.href) ? { 'aria-current': 'page' } : {}}
              >
                <Icon name={item.icon} class="site-nav__icon" aria-hidden="true" />
                <span>{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    /* ぼかし背景・影なし・下罫線で区切る */
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(1.3) blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: var(--header-height);
    padding-block: var(--space-2);
  }

  /* ---- ロゴ ---- */
  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-right: auto;
    color: var(--text-1);
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.2rem;
    letter-spacing: 0.04em;
  }
  .logo:hover {
    text-decoration: none;
  }
  .logo__text {
    white-space: nowrap;
  }

  /* ---- ナビ ---- */
  .site-nav__list {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }
  .site-nav__link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 12px;
    border-radius: var(--radius-s);
    color: var(--text-2);
    font-weight: 500;
    font-size: 0.9375rem;
    letter-spacing: 0.02em;
    transition:
      color var(--motion-fast),
      background-color var(--motion-fast);
  }
  .site-nav__icon {
    font-size: 1.15em;
    color: var(--text-2);
    transition: color var(--motion-fast);
  }
  .site-nav__link:hover {
    background: var(--surface-soft);
    color: var(--text-1);
    text-decoration: none;
  }
  .site-nav__link:hover .site-nav__icon {
    color: var(--accent);
  }
  .site-nav__link[aria-current="page"] {
    color: var(--accent-ink);
  }
  .site-nav__link[aria-current="page"] .site-nav__icon {
    color: var(--accent);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
  }

  /* ---- モバイル ---- */
  @media (max-width: 640px) {
    .site-header__inner {
      gap: var(--space-2);
    }
    .logo__text {
      font-size: 1.1rem;
    }
    /* ナビはアイコンのみ表示にして省スペース化 */
    .site-nav__link span {
      display: none;
    }
    .site-nav__icon {
      font-size: 1.4em;
    }
    .site-nav__link {
      padding: 8px 9px;
    }
  }
</style>
