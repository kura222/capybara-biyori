---
/**
 * 雑誌的セクション見出しの型（デザインガイドライン §5・全セクション統一）。
 *   ┌ 短い罫線
 *   01 — LIVE            ← Fraunces .label（字間.12em）
 *   いま配信中のカピバラ   ← Shippori Mincho h2
 *
 * Props:
 *   - index:       セクション番号（"01" 等。省略可）
 *   - label:       欧文小ラベル（"LIVE" 等・Fraunces）
 *   - title:       見出し（明朝 h2）
 *   - description: 補足説明（任意）
 *   - moreHref/moreLabel: 右側の導線リンク（任意）
 *   - width:       コンテナ幅（list=既定 / text / hero）
 *   - space:       セクション余白（l / m / s。重要度でリズムを付ける）
 *   - id/class
 */
import { Icon } from 'astro-icon/components';

interface Props {
  title: string;
  index?: string;
  label?: string;
  description?: string;
  moreHref?: string;
  moreLabel?: string;
  width?: 'list' | 'text' | 'hero';
  space?: 'l' | 'm' | 's';
  id?: string;
  class?: string;
}

const {
  title,
  index,
  label,
  description,
  moreHref,
  moreLabel = 'すべて見る',
  width = 'list',
  space = 'm',
  id,
  class: className = '',
} = Astro.props;

const containerClass =
  width === 'text' ? 'container container--text' : width === 'hero' ? 'container container--hero' : 'container';
---

<section class:list={['section', `section--space-${space}`, className]} {...id ? { id } : {}}>
  <div class={containerClass}>
    <div class="section__head">
      <div class="section__heading">
        {(index || label) && (
          <p class="section__kicker label">
            <span class="section__rule" aria-hidden="true"></span>
            {index && <span class="num section__index">{index}</span>}
            {index && label && <span class="section__dash" aria-hidden="true">—</span>}
            {label && <span>{label}</span>}
          </p>
        )}
        <h2 class="section__title">{title}</h2>
        {description && <p class="section__desc">{description}</p>}
      </div>
      {moreHref && (
        <a class="section__more" href={moreHref}>
          <span>{moreLabel}</span>
          <Icon name="ph:arrow-right" aria-hidden="true" />
        </a>
      )}
    </div>
    <slot />
  </div>
</section>

<style>
  .section {
    padding-block: var(--space-section-m);
  }
  .section--space-l {
    padding-block: var(--space-section-l);
  }
  .section--space-s {
    padding-block: var(--space-section-s);
  }

  .section__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
    flex-wrap: wrap;
  }

  .section__heading {
    min-width: 0;
  }

  /* 01 — LIVE（Fraunces小ラベル＋短い罫線） */
  .section__kicker {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 var(--space-3);
    color: var(--accent-ink);
  }
  .section__rule {
    width: 28px;
    height: 1px;
    background: var(--accent);
    opacity: 0.7;
  }
  .section__index {
    color: var(--text-2);
    font-size: 0.9375rem;
  }
  .section__dash {
    color: var(--text-3);
  }

  .section__title {
    margin: 0;
    color: var(--text-1);
  }

  .section__desc {
    margin: var(--space-3) 0 0;
    max-width: 60ch;
    color: var(--text-2);
    font-size: 0.9375rem;
  }

  .section__more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
    padding-bottom: 3px;
    font-weight: 500;
    font-size: 0.9375rem;
    color: var(--accent-ink);
  }
  .section__more :global(svg) {
    transition: transform var(--motion-fast);
  }
  .section__more:hover {
    text-decoration: none;
  }
  .section__more:hover :global(svg) {
    transform: translateX(3px);
  }

  @media (max-width: 640px) {
    .section__head {
      margin-bottom: var(--space-5);
    }
  }
</style>
