---
/**
 * サイト共通フッター（デザインガイドライン §9）。
 * - サイトマップ型（コンテンツ / サイト情報）＋ヘアライン区切り
 * - 最後に小さくマスコット
 * - 投げ銭導線（プレースホルダー・URLはP5で投入）
 * - アフィリエイト表記（inline 版 PrNotice）
 */
import { Icon } from 'astro-icon/components';
import { SITE, NAV_ITEMS, FOOTER_LINKS } from '../config';
import Mascot from './Mascot.astro';
import PrNotice from './PrNotice.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer u-grain">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <a class="site-footer__logo" href="/">
        <Mascot size={34} steam={false} />
        <span>{SITE.name}</span>
      </a>
      <p class="site-footer__tagline">{SITE.description}</p>
      <!-- 投げ銭導線（リンクはP5で有効化） -->
      <span class="site-footer__support" aria-disabled="true">
        <Icon name="ph:heart" aria-hidden="true" />
        カピバラのおやつ代を応援
      </span>
    </div>

    <nav class="site-footer__nav" aria-label="フッターナビゲーション">
      <div class="site-footer__col">
        <p class="label site-footer__heading">Explore</p>
        <ul>
          {NAV_ITEMS.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
          <li><a href="/">いまを見る</a></li>
        </ul>
      </div>
      <div class="site-footer__col">
        <p class="label site-footer__heading">About</p>
        <ul>
          {FOOTER_LINKS.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
          <li><a href="/about/#contact">お問い合わせ</a></li>
        </ul>
      </div>
    </nav>
  </div>

  <div class="site-footer__bottom">
    <div class="container site-footer__bottom-inner">
      <PrNotice variant="inline" />
      <div class="site-footer__sign">
        <Mascot size={20} steam={false} />
        <small class="site-footer__copy">© {year} {SITE.name}</small>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-section-l);
    background: var(--surface-deep);
    border-top: 1px solid var(--line);
    color: var(--text-2);
  }

  .site-footer__inner {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: var(--space-6);
    padding-block: var(--space-7);
  }

  .site-footer__logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text-1);
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: 0.04em;
  }
  .site-footer__logo:hover {
    text-decoration: none;
  }

  .site-footer__tagline {
    margin: var(--space-3) 0 var(--space-4);
    max-width: 42ch;
    color: var(--text-2);
    font-size: 0.9375rem;
    line-height: 1.8;
  }

  .site-footer__support {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--text-2);
    font-size: 0.875rem;
    font-weight: 500;
  }
  .site-footer__support :global(svg) {
    color: var(--accent);
    font-size: 1.05em;
  }

  .site-footer__nav {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-5);
  }

  .site-footer__heading {
    margin: 0 0 var(--space-4);
    color: var(--text-2);
  }

  .site-footer__col ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .site-footer__col a {
    color: var(--text-2);
    font-size: 0.9375rem;
  }
  .site-footer__col a:hover {
    color: var(--accent-ink);
    text-decoration: none;
  }

  /* ヘアライン区切り */
  .site-footer__bottom {
    border-top: 1px solid var(--line);
  }
  .site-footer__bottom-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-4);
    flex-wrap: wrap;
  }
  .site-footer__sign {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }
  .site-footer__copy {
    color: var(--text-2);
    font-size: 0.78rem;
    letter-spacing: 0.02em;
  }

  @media (max-width: 640px) {
    .site-footer__inner {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }
</style>
