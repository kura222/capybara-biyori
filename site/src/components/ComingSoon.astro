---
/**
 * 空状態（未提供ページ）の共通表示（デザインガイドライン §7）。
 * 型: 固有ビジュアル（マスコット）＋理由の1行＋次の行動導線。
 * 「準備中」バッジだけの表示は禁止。map / onsen / articles / about / privacy で使う。
 *
 * Props:
 *   - title:    見出し
 *   - lead:     理由の1行（なぜまだ無いか・何を準備しているか）
 *   - points:   このページで将来提供する内容（任意・編集的リスト）
 *   - backHref/backLabel: 主導線（既定=トップへ）
 *   - altHref/altLabel:   副導線（任意）
 */
import { Icon } from 'astro-icon/components';
import Mascot from './Mascot.astro';

interface Props {
  title: string;
  lead: string;
  points?: string[];
  backHref?: string;
  backLabel?: string;
  altHref?: string;
  altLabel?: string;
}

const {
  title,
  lead,
  points = [],
  backHref = '/',
  backLabel = 'トップへ戻る',
  altHref,
  altLabel,
} = Astro.props;
---

<section class="coming u-grain">
  <div class="container container--text coming__inner">
    <Mascot size={96} steam={true} class="coming__mascot" />
    <h1 class="coming__title">{title}</h1>
    <p class="coming__lead">{lead}</p>

    {points.length > 0 && (
      <div class="coming__panel">
        <p class="label coming__panel-label">Coming soon</p>
        <ul class="coming__points">
          {points.map((p) => (
            <li>
              <Icon name="ph:check" class="coming__check" aria-hidden="true" />
              <span>{p}</span>
            </li>
          ))}
        </ul>
      </div>
    )}

    <slot />

    <div class="coming__actions">
      <a class="btn btn--primary" href={backHref}>
        <Icon name="ph:arrow-left" aria-hidden="true" />
        {backLabel}
      </a>
      {altHref && altLabel && (
        <a class="btn btn--ghost" href={altHref}>
          {altLabel}
          <Icon name="ph:arrow-right" aria-hidden="true" />
        </a>
      )}
    </div>
  </div>
</section>

<style>
  .coming {
    padding-block: var(--space-section-l) var(--space-section-m);
  }
  .coming__inner {
    text-align: center;
  }
  .coming__mascot {
    margin: 0 auto var(--space-4);
  }
  .coming__title {
    margin: 0 0 var(--space-3);
  }
  .coming__lead {
    margin: 0 auto var(--space-6);
    max-width: 46ch;
    color: var(--text-2);
    line-height: 1.85;
  }

  /* 将来提供の内容: 編集的リスト（影の付いた箱にしない） */
  .coming__panel {
    display: inline-block;
    margin: 0 auto var(--space-6);
    padding: var(--space-5) var(--space-6);
    text-align: left;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
  }
  .coming__panel-label {
    margin: 0 0 var(--space-4);
    color: var(--accent);
  }
  .coming__points {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .coming__points li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    color: var(--text-1);
    font-size: 0.9375rem;
    line-height: 1.6;
  }
  .coming__check {
    flex-shrink: 0;
    margin-top: 0.28em;
    font-size: 1rem;
    color: var(--green);
  }

  .coming__actions {
    display: flex;
    justify-content: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-top: var(--space-4);
  }
</style>
