---
/**
 * ダークモード切替ボタン。
 * - クリックで light / dark を切り替え、localStorage("theme") に保存
 * - <html data-theme> を更新（FOUC防止スクリプトと同じキーを使用）
 * - アイコンは Phosphor（絵文字全廃・§5）
 * 初期状態の data-theme は BaseLayout 内のインラインスクリプトが設定済み。
 */
import { Icon } from 'astro-icon/components';
---

<button
  type="button"
  id="theme-toggle"
  class="theme-toggle"
  aria-label="配色テーマを切り替える"
  title="ライト / ダーク切替"
>
  <Icon name="ph:sun-dim" class="theme-toggle__icon theme-toggle__icon--sun" aria-hidden="true" />
  <Icon name="ph:moon-stars" class="theme-toggle__icon theme-toggle__icon--moon" aria-hidden="true" />
</button>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-s);
    border: 1px solid var(--line-strong);
    background: var(--surface);
    color: var(--text-2);
    transition:
      background-color var(--motion-fast),
      border-color var(--motion-fast),
      color var(--motion-fast);
  }
  .theme-toggle:hover {
    background: var(--surface-soft);
    border-color: var(--accent);
    color: var(--accent);
  }

  .theme-toggle__icon {
    grid-area: 1 / 1;
    font-size: 1.25rem;
  }

  /* 既定（ライト）は太陽を表示・月を隠す */
  .theme-toggle__icon--moon {
    display: none;
  }
  :global(:root[data-theme='dark']) .theme-toggle__icon--sun {
    display: none;
  }
  :global(:root[data-theme='dark']) .theme-toggle__icon--moon {
    display: block;
  }
</style>

<script>
  // クリックでテーマをトグルし、localStorage に保存する
  const toggle = document.getElementById('theme-toggle');
  toggle?.addEventListener('click', () => {
    const root = document.documentElement;
    const current = root.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
    const next = current === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try {
      localStorage.setItem('theme', next);
    } catch (e) {
      /* localStorage 不可の環境では保存をスキップ */
    }
  });
</script>
