# === カピバラ日和 リポジトリ用 .gitignore ===

# 依存関係
node_modules/

# ビルド成果物
dist/

# Astro 生成物
.astro/

# 環境変数（秘匿情報。APIキー等は絶対にコミットしない）
.env
.env.*
!.env.example

# ログ
*-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS / エディタ
.DS_Store
Thumbs.db
.idea/
*.swp

# Cloudflare Pages ローカル
.wrangler/
